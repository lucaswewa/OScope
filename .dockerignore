# Include only build inputs. Legacy local caches and recordings may still exist
# in a Windows checkout; they must never be sent to the Docker daemon.
**
!containers/
!containers/**
!rust-toolchain.toml
!Cargo.toml
!Cargo.lock
!.cargo/
!.cargo/config.toml
!LICENSE
!crates/
!crates/**
!examples/
!examples/**
!xtask/
!xtask/**
!python/
!python/**
!configs/
!configs/runtime.toml
# Keep local recordings, environments and build products out of every target.
**/.oscope
**/target
**/node_modules
**/.venv
**/__pycache__
**/.pytest_cache
**/*.pyc
**/*.omext
