    }
  },
  "actions": {
    "run": {
      "description": "A coarse sweep then a fine one, each position approached moving up;\nor one continuous sweep (`sweep`: `continuous`). Each option is\noptional: `measure` (`brenner`, `tenengrad` or `laplacian`; the\nlight's by default), `range_um` and `step_um` (6 depths of field and\none by default), `region` (the frame's middle half), `approach_um`\nand `settle_ms`. The job's result is the z found; it fails, saying\nwhy, on an empty field or a focus out of reach.",
      "title": "Autofocuses where the stage is: a hardware job.",
      "forms": [
        {
          "href": "/api/v1/autofocus/run",
          "op": [
            "invokeaction"
          ]
        },
        {
          "href": "/api/v1/action_invocations/{id}",
          "op": [
            "queryaction",
            "cancelaction"
          ]
        }
      ],
      "uriVariables": {
        "id": {
          "title": "Invocation ID",
          "format": "uuid",
          "type": "string"
        }
      },
