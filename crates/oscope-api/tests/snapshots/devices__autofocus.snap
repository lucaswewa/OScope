  "title": "Autofocus",
  "properties": {
    "defaults": {
      "description": "From the fitted objective, the camera's pixel and binning, and the\nlight on: the measure, the depth of field, and the sweep's reach and\nsteps.",
      "title": "Autofocus's defaults now.",
      "writeOnly": false,
      "readOnly": true,
      "type": "object",
      "properties": {
        "light": {
          "description": "The light on, by kind, if one is.",
          "oneOf": [
            {
              "description": "Where a light shines from.",
              "oneOf": [
                {
                  "description": "Through the sample, from below: brightfield.",
                  "const": "transmitted",
                  "type": "string"
                },
                {
                  "description": "Onto the sample, through the objective or beside it.",
                  "const": "reflected",
                  "type": "string"
                },
                {
                  "description": "Anything else a controller offers.",
                  "const": "other",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "measure": {
          "description": "Its measure.",
          "oneOf": [
            {
              "description": "Brenner's gradient: transmitted light's default.",
              "const": "brenner",
              "type": "string"
            },
            {
              "description": "Tenengrad: reflected light's.",
              "const": "tenengrad",
              "type": "string"
            },
            {
              "description": "The variance of the Laplacian: fluorescence's.",
              "const": "laplacian",
              "type": "string"
            }
          ]
        },
        "depth_of_field_um": {
          "description": "The depth of field, in µm.",
          "type": "number"
        },
        "range_um": {
          "description": "The sweep's reach either side, in µm.",
          "type": "number"
        },
        "coarse_um": {
          "description": "The coarse step, in µm.",
          "type": "number"
        },
        "fine_um": {
          "description": "The fine step, in µm.",
          "type": "number"
        },
        "approach_um": {
          "description": "The approach, in µm.",
          "type": "number"
        }
      },
      "required": [
        "measure",
        "depth_of_field_um",
        "range_um",
        "coarse_um",
        "fine_um",
        "approach_um"
