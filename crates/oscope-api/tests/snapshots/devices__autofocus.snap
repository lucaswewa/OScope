    "measures": {
      "description": "Brenner's gradient, Tenengrad and the variance of the Laplacian of\nthe next frame's middle, where the stage is, without moving.",
      "title": "The focus measures now.",
      "writeOnly": false,
      "readOnly": true,
      "type": "object",
      "properties": {
        "brenner": {
          "description": "Brenner's gradient.",
          "type": "number"
        },
