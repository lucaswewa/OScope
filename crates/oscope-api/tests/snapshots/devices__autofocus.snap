          "op": [
            "readproperty"
          ]
        }
      ]
    },
    "last": {
      "description": "Where it left the stage, whether it found a focus or why not, and\nits curves.",
      "title": "The latest run's report.",
      "writeOnly": false,
      "readOnly": true,
      "oneOf": [
        {
          "description": "What an autofocus run did.",
          "type": "object",
          "properties": {
            "z_um": {
              "description": "Where it left the stage, in µm: the focus found, or where it started.",
              "type": "number"
            },
            "found": {
              "description": "Whether it found a focus.",
              "type": "boolean"
            },
            "start_um": {
              "description": "Where the stage was, in µm, when it started.",
              "type": "number"
            },
            "measure": {
              "description": "The measure used.",
              "oneOf": [
                {
                  "description": "Brenner's gradient: transmitted light's default.",
                  "const": "brenner",
                  "type": "string"
                },
                {
                  "description": "Tenengrad: reflected light's.",
                  "const": "tenengrad",
                  "type": "string"
                },
                {
                  "description": "The variance of the Laplacian: fluorescence's.",
                  "const": "laplacian",
                  "type": "string"
                }
              ]
            },
            "sweep": {
              "description": "How it swept.",
              "oneOf": [
                {
                  "description": "Position by position: a coarse sweep, then a fine one.",
                  "const": "stepped",
                  "type": "string"
                },
                {
                  "description": "One pass at a constant speed, frames matched to z by their times.",
                  "const": "continuous",
                  "type": "string"
                }
              ]
            },
            "depth_of_field_um": {
              "description": "The depth of field, in µm.",
              "type": "number"
            },
            "coarse": {
              "description": "The coarse sweep's curve, or a continuous sweep's frames, in z.",
              "type": "array",
              "items": {
                "description": "A point of a focus curve: a frame's z and its measure.",
                "type": "object",
                "properties": {
                  "z_um": {
                    "description": "The stage's z, in µm.",
                    "type": "number"
                  },
                  "value": {
                    "description": "The measure.",
                    "type": "number"
                  }
                },
                "required": [
                  "z_um",
                  "value"
                ]
              }
            },
            "fine": {
              "description": "The fine sweep's curve; none for a continuous sweep.",
              "type": "array",
              "items": {
                "description": "A point of a focus curve: a frame's z and its measure.",
                "type": "object",
                "properties": {
                  "z_um": {
                    "description": "The stage's z, in µm.",
                    "type": "number"
                  },
                  "value": {
                    "description": "The measure.",
                    "type": "number"
                  }
                },
                "required": [
                  "z_um",
                  "value"
                ]
              }
            },
            "frames": {
              "description": "How many frames it measured.",
              "type": "integer",
              "minimum": 0
            },
            "took_ms": {
              "description": "How long it took, in ms of the server's clock.",
              "type": "number"
            },
            "speed_um_s": {
              "description": "For a continuous sweep, its speed, in µm/s.",
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "refused": {
              "description": "Why it found no focus, if it didn't.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "z_um",
            "found",
            "start_um",
            "measure",
            "sweep",
            "depth_of_field_um",
            "coarse",
            "fine",
            "frames",
            "took_ms"
          ]
