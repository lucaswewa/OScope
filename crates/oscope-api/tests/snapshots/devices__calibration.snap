    "check_objective": {
      "description": "Whether the objective fitted is the one in the light path: two small\nmoves measure the pixel size, whatever the camera's turn, and\nwithin 20 % of what the objective's should be, it is plausible.\nOtherwise the catalogue's nearest objective is named.\n\nA job on the instrument: its report becomes `last_check`.",
      "title": "Checks the objective.",
      "forms": [
        {
          "href": "/api/v1/calibration/check_objective",
          "op": [
            "invokeaction"
          ]
        },
        {
          "href": "/api/v1/action_invocations/{id}",
          "op": [
            "queryaction",
            "cancelaction"
          ]
        }
      ],
