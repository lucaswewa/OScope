            "type": "string"
          },
          "steps": {
            "description": "Its steps.",
            "type": "array",
            "items": {
              "description": "A step: what it is, and where it stands.",
              "type": "object",
              "properties": {
                "kind": {
                  "description": "What it is.",
                  "oneOf": [
                    {
                      "description": "The objective check.",
                      "const": "objective",
                      "type": "string"
                    },
                    {
                      "description": "The geometry: the pixel size and the camera-to-stage matrix.",
                      "const": "geometry",
                      "type": "string"
                    },
                    {
                      "description": "A dark frame.",
                      "const": "dark",
                      "type": "string"
                    },
                    {
                      "description": "A flat field, and the white balance.",
                      "const": "flat",
                      "type": "string"
                    },
                    {
                      "description": "The colour matrix.",
                      "const": "colour",
                      "type": "string"
                    },
                    {
                      "description": "The stage: backlash, homing, soft limits.",
                      "const": "stage",
                      "type": "string"
                    }
                  ]
                },
                "title": {
                  "description": "Its title.",
                  "type": "string"
                },
                "prompt": {
                  "description": "What to do before confirming it.",
                  "type": "string"
                },
                "state": {
                  "description": "Where it stands.",
                  "oneOf": [
                    {
                      "description": "Not reached yet.",
                      "type": "object",
                      "properties": {
                        "state": {
                          "const": "waiting",
                          "type": "string"
                        }
                      },
                      "required": [
                        "state"
                      ]
                    },
                    {
                      "description": "Its prompt is shown: do what it asks, then confirm.",
                      "type": "object",
                      "properties": {
                        "state": {
                          "const": "prompting",
                          "type": "string"
                        }
                      },
                      "required": [
