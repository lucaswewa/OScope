              "description": "The camera's binning.",
              "type": "integer",
              "minimum": 0
            },
            "expected_pixel_um": {
              "description": "The pixel size expected, in µm: the active geometry's, or else the\nnominal.",
              "type": "number"
            },
            "calibrated": {
              "description": "Whether the pixel size expected is a calibration's.",
              "type": "boolean"
            },
            "measured_pixel_um": {
              "description": "The pixel size measured, in µm.",
              "type": "number"
            },
            "ratio": {
              "description": "Measured over expected.",
              "type": "number"
            },
            "plausible": {
              "description": "Whether it is within 20 % of the expected.",
              "type": "boolean"
            },
            "nearest": {
              "description": "The catalogue's objective whose nominal pixel size is nearest the\nmeasured one.",
              "type": "string"
            },
            "checked": {
              "description": "When it was checked.",
              "format": "date-time",
              "type": "string"
            }
