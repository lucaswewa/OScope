                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "format",
          "id",
          "version",
          "created",
          "instrument",
          "values"
        ]
      },
      "synchronous": false
    },
    "geometry": {
      "description": "The fitted objective's, at the camera's binning: a 3 × 3 grid of stage moves `step_um` apart (a quarter of the frame's\nmiddle, if not given), each frame registered, and the camera-to-stage\nmatrix fitted. Each position is reached from `approach_um` before it\n(50), and its frame exposed from `settle_ms` after the stage arrives\n(50). The set is made active unless `activate` is false.\n\nA job on the instrument: answered at once with where to follow it.\nIts result is the set, `calibration/<id>`.",
      "title": "Measures the geometry.",
      "forms": [
        {
          "href": "/api/v1/calibration/geometry",
          "op": [
            "invokeaction"
          ]
        },
        {
          "href": "/api/v1/action_invocations/{id}",
          "op": [
            "queryaction",
            "cancelaction"
          ]
        }
      ],
      "uriVariables": {
        "id": {
          "title": "Invocation ID",
          "format": "uuid",
          "type": "string"
        }
      },
      "input": {
        "title": "geometry_input",
        "type": "object",
        "properties": {
          "step_um": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "approach_um": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "settle_ms": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "activate": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "output": {
        "description": "Where to follow a job an action has started: what such an action\nanswers with at once (the `JobRef` pattern, ADR-0016).",
        "title": "geometry_output",
        "type": "object",
        "properties": {
          "id": {
            "description": "The job.",
            "format": "uuid",
            "type": "string"
          },
          "href": {
            "description": "Where it is, as it is now.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "href"
        ]
      },
      "synchronous": false
    },
    "import": {
      "description": "A set exported elsewhere: checked, and kept as the next version of its\nkey, not active.",
      "title": "Imports a set.",
      "forms": [
        {
          "href": "/api/v1/calibration/import",
          "op": [
            "invokeaction"
          ]
        },
        {
          "href": "/api/v1/action_invocations/{id}",
          "op": [
            "queryaction",
            "cancelaction"
          ]
        }
      ],
      "uriVariables": {
        "id": {
          "title": "Invocation ID",
          "format": "uuid",
          "type": "string"
        }
      },
      "input": {
        "title": "import_input",
        "type": "object",
        "properties": {
          "set": {}
        },
        "required": [
          "set"
        ],
        "additionalProperties": false
      },
      "output": {
        "description": "A calibration set (ADR-0023). It is never changed: a new calibration of\nthe same key is its next version.",
        "title": "import_output",
        "type": "object",
        "properties": {
          "format": {
            "description": "The version of its JSON: 1.",
            "type": "integer",
            "minimum": 0
          },
          "id": {
            "description": "Its ID.",
            "format": "uuid",
            "type": "string"
          },
          "version": {
            "description": "Its version among the sets of its key, from 1.",
            "type": "integer",
            "minimum": 0
          },
          "created": {
            "description": "When it was made.",
            "format": "date-time",
            "type": "string"
          },
          "account": {
            "description": "Who made it.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "instrument": {
            "description": "The instrument as it was.",
            "type": "object",
            "properties": {
              "camera": {
                "description": "The camera's maker and model.",
                "type": "string"
              },
              "sensor_pixel_um": {
                "description": "The sensor's pixel, in µm.",
                "type": "number"
              },
              "binning": {
                "description": "The camera's binning.",
                "type": "integer",
                "minimum": 0
              },
              "stage": {
                "description": "The stage's maker and model.",
                "type": "string"
              },
              "objective": {
                "description": "The objective fitted, if one was.",
                "oneOf": [
                  {
                    "description": "One objective.",
                    "type": "object",
                    "properties": {
                      "name": {
                        "description": "Its name, unique in the catalogue, such as `20x`. Frames record it.",
                        "type": "string"
                      },
                      "model": {
                        "description": "Its maker and model.",
                        "default": "",
                        "type": "string"
                      },
                      "magnification": {
                        "description": "Its magnification, with the tube lens it was designed for.",
                        "type": "number"
                      },
                      "na": {
                        "description": "Its numerical aperture.",
                        "type": "number"
                      },
                      "working_distance": {
                        "description": "The distance from its front to the sample in focus.",
                        "type": "number"
                      },
                      "design_tube_lens": {
                        "description": "The tube lens it was designed for: 200 mm, Mitutoyo's, unless the\ncatalogue says otherwise.",
                        "default": 200000.0,
                        "type": "number"
                      }
                    },
                    "required": [
                      "name",
                      "magnification",
                      "na",
                      "working_distance"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tube_lens_um": {
                "description": "The instrument's tube lens, in µm.",
                "type": "number"
              }
            },
            "required": [
              "camera",
              "sensor_pixel_um",
              "binning",
              "stage",
              "tube_lens_um"
            ]
          },
          "values": {
            "description": "What it measured.",
            "oneOf": [
              {
                "description": "An objective's geometry at a binning.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "geometry",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "description": "The stage's.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "stage",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            ]
          },
          "imported_from": {
            "description": "The ID it had where it came from, if it was imported.",
            "oneOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "format",
          "id",
          "version",
          "created",
          "instrument",
          "values"
        ]
      },
      "synchronous": false
    },
    "stage": {
      "description": "It homes the stage unless `home` is false, records its soft limits, and measures x's and y's backlash where it was, `cycles` times\neach (3). It needs the active geometry of the fitted objective.\n\nA job on the instrument: answered at once with where to follow it.\nIts result is the set, `calibration/<id>`.",
      "title": "Measures the stage.",
      "forms": [
        {
          "href": "/api/v1/calibration/stage",
          "op": [
            "invokeaction"
          ]
        },
        {
          "href": "/api/v1/action_invocations/{id}",
          "op": [
            "queryaction",
            "cancelaction"
          ]
        }
      ],
      "uriVariables": {
        "id": {
          "title": "Invocation ID",
          "format": "uuid",
          "type": "string"
        }
      },
      "input": {
        "title": "stage_input",
        "type": "object",
        "properties": {
          "home": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "cycles": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "approach_um": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "settle_ms": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "activate": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "output": {
        "description": "Where to follow a job an action has started: what such an action\nanswers with at once (the `JobRef` pattern, ADR-0016).",
        "title": "stage_output",
        "type": "object",
        "properties": {
          "id": {
            "description": "The job.",
            "format": "uuid",
            "type": "string"
          },
          "href": {
            "description": "Where it is, as it is now.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "href"
        ]
      },
      "synchronous": false
    }
  },
  "description": "The calibration sets, kept and versioned (ADR-0023), and the jobs that\nmeasure them.",
  "forms": [
    {
      "href": "/api/v1/calibration/properties",
      "op": [
        "readallproperties"
      ]
    },
    {
      "href": "/api/v1/calibration/actions",
      "op": [
        "queryallactions"
      ]
    }
  ],
  "base": "http://127.0.0.1:8220/",
  "securityDefinitions": {
    "no_security": {
      "description": "No security",
      "scheme": "nosec"
    }
  },
  "security": "no_security",
  "@type": "saref:Function"
}
