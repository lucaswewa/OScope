    "wizard": {
      "description": "Its steps, each with what to do before confirming it, and where each\nstands: the step in hand settled first if its job has ended.",
      "title": "The calibration wizard.",
      "writeOnly": false,
      "readOnly": true,
      "oneOf": [
        {
          "description": "The calibration wizard.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Its ID.",
              "format": "uuid",
              "type": "string"
            },
            "started": {
              "description": "When it started.",
              "format": "date-time",
              "type": "string"
            },
            "steps": {
              "description": "Its steps.",
              "type": "array",
              "items": {
                "description": "A step: what it is, and where it stands.",
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "What it is.",
                    "oneOf": [
                      {
                        "description": "The objective check.",
                        "const": "objective",
                        "type": "string"
                      },
                      {
                        "description": "The geometry: the pixel size and the camera-to-stage matrix.",
                        "const": "geometry",
                        "type": "string"
                      },
                      {
                        "description": "A dark frame.",
                        "const": "dark",
                        "type": "string"
                      },
                      {
                        "description": "A flat field, and the white balance.",
                        "const": "flat",
                        "type": "string"
                      },
                      {
                        "description": "The colour matrix.",
                        "const": "colour",
                        "type": "string"
                      },
                      {
                        "description": "The stage: backlash, homing, soft limits.",
                        "const": "stage",
                        "type": "string"
                      }
                    ]
                  },
                  "title": {
                    "description": "Its title.",
                    "type": "string"
                  },
                  "prompt": {
                    "description": "What to do before confirming it.",
                    "type": "string"
                  },
                  "state": {
                    "description": "Where it stands.",
                    "oneOf": [
                      {
                        "description": "Not reached yet.",
                        "type": "object",
                        "properties": {
                          "state": {
                            "const": "waiting",
                            "type": "string"
                          }
                        },
                        "required": [
                          "state"
                        ]
                      },
                      {
                        "description": "Its prompt is shown: do what it asks, then confirm.",
                        "type": "object",
                        "properties": {
                          "state": {
                            "const": "prompting",
                            "type": "string"
                          }
                        },
                        "required": [
                          "state"
                        ]
                      },
                      {
                        "description": "Its job runs.",
                        "type": "object",
                        "properties": {
                          "job": {
                            "description": "The job.",
                            "format": "uuid",
                            "type": "string"
                          },
                          "state": {
                            "const": "running",
                            "type": "string"
                          }
                        },
                        "required": [
                          "state",
                          "job"
                        ]
                      },
                      {
                        "description": "Done.",
                        "type": "object",
                        "properties": {
                          "result": {
                            "description": "What it made: a set, `calibration/<id>`, or a check's verdict.",
                            "type": "string"
                          },
                          "state": {
                            "const": "done",
                            "type": "string"
                          }
                        },
                        "required": [
                          "state",
                          "result"
                        ]
                      },
                      {
                        "description": "Skipped.",
                        "type": "object",
                        "properties": {
                          "state": {
                            "const": "skipped",
                            "type": "string"
                          }
                        },
                        "required": [
                          "state"
                        ]
                      },
                      {
                        "description": "Failed: it may be retried, or skipped.",
                        "type": "object",
                        "properties": {
                          "error": {
                            "description": "Why.",
                            "type": "string"
                          },
                          "state": {
                            "const": "failed",
                            "type": "string"
                          }
                        },
                        "required": [
                          "state",
                          "error"
                        ]
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "title",
                  "prompt",
                  "state"
                ]
              }
            },
            "current": {
              "description": "The step in hand, by index; the steps' count once finished.",
              "type": "integer",
              "minimum": 0
            },
            "finished": {
              "description": "Whether every step is settled, or it was cancelled.",
              "type": "boolean"
            },
            "cancelled": {
              "description": "Whether it was cancelled.",
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "started",
            "steps",
            "current",
            "finished",
            "cancelled"
          ]
        },
        {
          "type": "null"
        }
      ],
      "forms": [
        {
          "href": "/api/v1/calibration/wizard",
          "op": [
            "readproperty"
          ]
        }
      ]
    }
  },
