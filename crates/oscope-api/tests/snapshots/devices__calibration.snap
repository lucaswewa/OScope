                      ]
                    },
                    {
                      "description": "Its job runs.",
                      "type": "object",
                      "properties": {
                        "job": {
                          "description": "The job.",
                          "format": "uuid",
                          "type": "string"
                        },
                        "state": {
                          "const": "running",
                          "type": "string"
                        }
                      },
                      "required": [
                        "state",
                        "job"
                      ]
                    },
                    {
                      "description": "Done.",
                      "type": "object",
                      "properties": {
                        "result": {
                          "description": "What it made: a set, `calibration/<id>`, or a check's verdict.",
                          "type": "string"
                        },
                        "state": {
                          "const": "done",
                          "type": "string"
                        }
                      },
                      "required": [
                        "state",
                        "result"
                      ]
                    },
                    {
                      "description": "Skipped.",
                      "type": "object",
                      "properties": {
                        "state": {
                          "const": "skipped",
                          "type": "string"
                        }
                      },
                      "required": [
                        "state"
                      ]
                    },
                    {
                      "description": "Failed: it may be retried, or skipped.",
                      "type": "object",
                      "properties": {
                        "error": {
                          "description": "Why.",
                          "type": "string"
                        },
                        "state": {
                          "const": "failed",
                          "type": "string"
                        }
                      },
                      "required": [
                        "state",
                        "error"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "title",
                "prompt",
                "state"
              ]
            }
          },
          "current": {
            "description": "The step in hand, by index; the steps' count once finished.",
            "type": "integer",
            "minimum": 0
          },
          "finished": {
            "description": "Whether every step is settled, or it was cancelled.",
            "type": "boolean"
          },
          "cancelled": {
            "description": "Whether it was cancelled.",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "started",
          "steps",
          "current",
          "finished",
          "cancelled"
        ]
      },
      "synchronous": false
    },
