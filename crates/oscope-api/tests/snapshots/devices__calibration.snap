    "last_check": {
      "description": "Since the server started: whether the objective fitted is the one in\nthe light path.",
      "title": "The latest objective check.",
      "writeOnly": false,
      "readOnly": true,
      "oneOf": [
        {
          "description": "The objective check's report.",
          "type": "object",
          "properties": {
            "objective": {
              "description": "The objective fitted.",
              "type": "string"
            },
