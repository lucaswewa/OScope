                          "properties": {
                            "pattern": {
                              "description": "The mosaic's first cell.",
                              "oneOf": [
                                {
                                  "description": "Red, green; green, blue. The MIChrome 20's.",
                                  "const": "RGGB",
                                  "type": "string"
                                },
                                {
                                  "description": "Green, red; blue, green.",
                                  "const": "GRBG",
                                  "type": "string"
                                },
                                {
                                  "description": "Green, blue; red, green.",
                                  "const": "GBRG",
                                  "type": "string"
                                },
                                {
                                  "description": "Blue, green; green, red.",
                                  "const": "BGGR",
                                  "type": "string"
                                }
                              ]
                            },
                            "significant_bits": {
                              "description": "How many of the 16 bits carry data.",
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 255
                            },
                            "kind": {
                              "const": "bayer16",
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "pattern",
                            "significant_bits"
                          ]
                        },
                        {
                          "description": "A Bayer mosaic in 8-bit samples.",
                          "type": "object",
                          "properties": {
                            "pattern": {
                              "description": "The mosaic's first cell.",
                              "oneOf": [
                                {
                                  "description": "Red, green; green, blue. The MIChrome 20's.",
                                  "const": "RGGB",
                                  "type": "string"
                                },
                                {
                                  "description": "Green, red; blue, green.",
                                  "const": "GRBG",
                                  "type": "string"
                                },
                                {
                                  "description": "Green, blue; red, green.",
                                  "const": "GBRG",
                                  "type": "string"
                                },
                                {
                                  "description": "Blue, green; green, red.",
                                  "const": "BGGR",
                                  "type": "string"
                                }
                              ]
                            },
                            "kind": {
                              "const": "bayer8",
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "pattern"
                          ]
                        },
                        {
                          "description": "Grey, 8 bits.",
                          "type": "object",
                          "properties": {
