          "href": "/api/v1/camera/trigger_exposure",
          "op": [
            "invokeaction"
          ]
        },
        {
          "href": "/api/v1/action_invocations/{id}",
          "op": [
            "queryaction",
            "cancelaction"
          ]
        }
      ],
      "uriVariables": {
        "id": {
          "title": "Invocation ID",
          "format": "uuid",
          "type": "string"
        }
      },
      "input": {
        "description": "Represent the input of an action that never takes parameters.\n\nThis may be either an empty dictionary or ``None``.",
        "title": "trigger_exposure_input",
        "oneOf": [
          {
            "description": "A model representing an object that must have no keys.",
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "output": {
        "title": "trigger_exposure_output",
        "type": "null"
      },
      "synchronous": false
    }
  },
  "events": {
    "mode_changed": {
      "description": "The mode or the pixel format changed.",
      "title": "The mode or the pixel format changed.",
      "forms": [
        {
          "href": "/api/v1/camera/mode_changed",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "subprotocol": "sse"
        },
        {
          "href": "ws://127.0.0.1:8220/api/v1/camera/ws",
          "op": [
            "subscribeevent"
          ]
        }
      ],
      "data": {
        "description": "A mode and a pixel format, set together.",
        "type": "object",
        "properties": {
          "mode": {
            "description": "The mode, by name.",
            "type": "string"
          },
          "format": {
            "description": "The pixel format.",
            "oneOf": [
              {
                "description": "A Bayer mosaic in 16-bit samples, of which `significant_bits` carry\ndata, aligned high.",
                "type": "object",
                "properties": {
                  "pattern": {
                    "description": "The mosaic's first cell.",
                    "oneOf": [
                      {
                        "description": "Red, green; green, blue. The MIChrome 20's.",
                        "const": "RGGB",
                        "type": "string"
                      },
                      {
                        "description": "Green, red; blue, green.",
                        "const": "GRBG",
                        "type": "string"
                      },
                      {
                        "description": "Green, blue; red, green.",
                        "const": "GBRG",
                        "type": "string"
                      },
                      {
                        "description": "Blue, green; green, red.",
                        "const": "BGGR",
                        "type": "string"
                      }
                    ]
                  },
                  "significant_bits": {
                    "description": "How many of the 16 bits carry data.",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "kind": {
                    "const": "bayer16",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "pattern",
                  "significant_bits"
                ]
              },
              {
                "description": "A Bayer mosaic in 8-bit samples.",
                "type": "object",
                "properties": {
                  "pattern": {
                    "description": "The mosaic's first cell.",
                    "oneOf": [
                      {
                        "description": "Red, green; green, blue. The MIChrome 20's.",
                        "const": "RGGB",
                        "type": "string"
                      },
                      {
                        "description": "Green, red; blue, green.",
                        "const": "GRBG",
                        "type": "string"
                      },
                      {
                        "description": "Green, blue; red, green.",
                        "const": "GBRG",
                        "type": "string"
                      },
                      {
                        "description": "Blue, green; green, red.",
                        "const": "BGGR",
                        "type": "string"
                      }
                    ]
                  },
                  "kind": {
                    "const": "bayer8",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "pattern"
                ]
              },
              {
                "description": "Grey, 8 bits.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "mono8",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "description": "Grey, 16 bits.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "mono16",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "description": "Red, green and blue, 8 bits each.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "rgb8",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "description": "Red, green and blue, 16 bits each.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "rgb16",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "description": "Red, green, blue and alpha, 8 bits each.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "rgba8",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "description": "Planes of 32-bit floats, one after another.",
                "type": "object",
                "properties": {
                  "planes": {
                    "description": "How many planes.",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "kind": {
                    "const": "planar_f32",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "planes"
                ]
              }
            ]
          }
        },
        "required": [
          "mode",
          "format"
        ]
      }
    }
  },
  "description": "The camera: its settings, and streaming. Frames go to acquisition,\nwhich completes them with the stage's position, the objective and the\nlights, and publishes them on the frame bus.",
  "forms": [
    {
      "href": "/api/v1/camera/properties",
      "op": [
        "readallproperties",
        "writemultipleproperties"
