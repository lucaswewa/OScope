{
  "id": "urn:uuid:333faa59-03cd-56e4-a9f4-90b3a40c4303",
  "title": "Camera",
  "properties": {
    "capabilities": {
      "description": "Its sensor, modes and rates, pixel formats, exposure and gain ranges,\nROI rules and triggers.",
      "title": "What the camera is and offers.",
      "writeOnly": false,
      "readOnly": true,
      "type": "object",
      "properties": {
        "model": {
          "description": "The camera's maker and model.",
          "type": "string"
        },
        "sensor_width": {
          "description": "The sensor's width in pixels.",
          "type": "integer",
          "minimum": 0
        },
        "sensor_height": {
          "description": "The sensor's height in pixels.",
          "type": "integer",
          "minimum": 0
        },
        "pixel_size": {
          "description": "The size of a sensor pixel.",
          "type": "number"
        },
        "shutter": {
          "description": "How its rows are exposed.",
          "oneOf": [
            {
              "description": "Every row at once.",
              "const": "global",
              "type": "string"
            },
            {
              "description": "Row after row, each a line time after the one above, so motion shears\nthe frame. The MIChrome 20's is (P02b).",
              "const": "rolling",
              "type": "string"
            }
          ]
        },
        "modes": {
          "description": "Its modes. The first is the default.",
          "type": "array",
          "items": {
            "description": "One of a camera's modes: a frame size, its binning, and its rates.",
            "type": "object",
            "properties": {
              "name": {
                "description": "Its name, by which settings choose it.",
                "type": "string"
              },
              "width": {
                "description": "The frame's width in pixels, without an ROI.",
                "type": "integer",
                "minimum": 0
              },
              "height": {
                "description": "The frame's height in pixels, without an ROI.",
                "type": "integer",
                "minimum": 0
              },
              "binning": {
                "description": "How many sensor pixels each of its pixels combines, along each axis.",
                "type": "integer",
                "minimum": 0
              },
              "rates": {
                "description": "The pixel formats it offers, each with its fastest rate.",
                "type": "array",
                "items": {
                  "description": "The fastest frame rate of a mode in one pixel format, at a short\nexposure.",
                  "type": "object",
                  "properties": {
                    "format": {
                      "description": "The pixel format.",
                      "oneOf": [
                        {
                          "description": "A Bayer mosaic in 16-bit samples, of which `significant_bits` carry\ndata, aligned high.",
