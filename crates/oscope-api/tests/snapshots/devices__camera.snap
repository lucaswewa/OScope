          "description": "The longest exposure.",
          "type": "number"
        },
        "gain_min": {
          "description": "The least gain, in the camera's units.",
          "type": "number"
        },
        "gain_max": {
          "description": "The most gain.",
          "type": "number"
        },
        "roi": {
          "description": "The ROIs it accepts, or `None` if it accepts none.",
          "oneOf": [
            {
              "description": "The ROIs a camera accepts.",
              "type": "object",
              "properties": {
                "x_step": {
                  "description": "The camera rounds an ROI's x offset and width down to multiples of\nthis. The MIChrome 20's is 2 (P02b).",
                  "type": "integer",
                  "minimum": 0
                },
                "y_step": {
                  "description": "The same, for the y offset and height.",
                  "type": "integer",
                  "minimum": 0
                },
                "min_size": {
                  "description": "The least width and height.",
                  "type": "integer",
                  "minimum": 0
                },
                "raises_rate": {
                  "description": "Whether a smaller ROI raises the frame rate. The MIChrome 20's\ndoesn't (P02b).",
                  "type": "boolean"
                }
              },
              "required": [
                "x_step",
                "y_step",
                "min_size",
                "raises_rate"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "trigger": {
          "description": "How it can be triggered.",
          "type": "object",
          "properties": {
            "software": {
              "description": "By software.",
              "type": "boolean"
            },
            "external": {
              "description": "By its trigger input. The MIChrome 20 has none; the camera that will\nreplace it has one (P02b).",
              "type": "boolean"
            },
            "output": {
              "description": "Whether it has a trigger output, which marks each exposure.",
              "type": "boolean"
            }
          },
          "required": [
            "software",
            "external",
            "output"
          ]
        },
        "sensor_timestamps": {
          "description": "Whether its frames carry the sensor's own timestamps. The\nMIChrome 20's don't (P02b).",
          "type": "boolean"
        },
        "temperature": {
          "description": "Whether it reports its sensor's temperature.",
          "type": "boolean"
        }
