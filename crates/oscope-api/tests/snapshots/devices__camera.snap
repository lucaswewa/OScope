    "settings": {
      "description": "The mode, pixel format, exposure, gain, ROI and trigger.",
      "title": "All its settings.",
      "writeOnly": false,
      "readOnly": true,
      "type": "object",
      "properties": {
        "mode": {
          "description": "The mode, by name.",
          "type": "string"
        },
        "format": {
          "description": "The pixel format of its frames.",
          "oneOf": [
            {
              "description": "A Bayer mosaic in 16-bit samples, of which `significant_bits` carry\ndata, aligned high.",
              "type": "object",
              "properties": {
                "pattern": {
                  "description": "The mosaic's first cell.",
                  "oneOf": [
                    {
                      "description": "Red, green; green, blue. The MIChrome 20's.",
                      "const": "RGGB",
                      "type": "string"
                    },
                    {
                      "description": "Green, red; blue, green.",
                      "const": "GRBG",
                      "type": "string"
                    },
                    {
                      "description": "Green, blue; red, green.",
                      "const": "GBRG",
                      "type": "string"
                    },
                    {
                      "description": "Blue, green; green, red.",
                      "const": "BGGR",
                      "type": "string"
                    }
                  ]
                },
                "significant_bits": {
                  "description": "How many of the 16 bits carry data.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "kind": {
                  "const": "bayer16",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "pattern",
                "significant_bits"
              ]
            },
            {
              "description": "A Bayer mosaic in 8-bit samples.",
              "type": "object",
              "properties": {
                "pattern": {
                  "description": "The mosaic's first cell.",
                  "oneOf": [
                    {
                      "description": "Red, green; green, blue. The MIChrome 20's.",
                      "const": "RGGB",
                      "type": "string"
                    },
                    {
                      "description": "Green, red; blue, green.",
                      "const": "GRBG",
                      "type": "string"
                    },
                    {
                      "description": "Green, blue; red, green.",
                      "const": "GBRG",
                      "type": "string"
                    },
                    {
                      "description": "Blue, green; green, red.",
                      "const": "BGGR",
                      "type": "string"
                    }
                  ]
                },
                "kind": {
                  "const": "bayer8",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "pattern"
              ]
            },
            {
              "description": "Grey, 8 bits.",
              "type": "object",
              "properties": {
                "kind": {
                  "const": "mono8",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "description": "Grey, 16 bits.",
              "type": "object",
              "properties": {
                "kind": {
                  "const": "mono16",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "description": "Red, green and blue, 8 bits each.",
              "type": "object",
              "properties": {
                "kind": {
                  "const": "rgb8",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "description": "Red, green and blue, 16 bits each.",
              "type": "object",
              "properties": {
                "kind": {
                  "const": "rgb16",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "description": "Red, green, blue and alpha, 8 bits each.",
              "type": "object",
              "properties": {
                "kind": {
                  "const": "rgba8",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "description": "Planes of 32-bit floats, one after another.",
              "type": "object",
              "properties": {
                "planes": {
                  "description": "How many planes.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "kind": {
                  "const": "planar_f32",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "planes"
              ]
            }
          ]
        },
        "exposure": {
          "description": "How long each row is exposed.",
          "type": "number"
        },
        "gain": {
          "description": "The gain, in the camera's units.",
          "type": "number"
        },
        "roi": {
          "description": "The sensor's pixels to read, in full-sensor coordinates (ADR-0007),\nor `None` for the whole sensor.",
          "oneOf": [
            {
              "description": "A rectangle of whole pixels: the column and row of its top-left pixel, and\nits size.",
              "type": "object",
              "properties": {
                "x": {
                  "description": "The column of its left edge.",
