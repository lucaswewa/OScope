              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "output": {
        "description": "Where to follow a job an action has started: what such an action\nanswers with at once (the `JobRef` pattern, ADR-0016).",
        "title": "auto_output",
        "type": "object",
        "properties": {
          "id": {
            "description": "The job.",
            "format": "uuid",
            "type": "string"
          },
          "href": {
            "description": "Where it is, as it is now.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "href"
        ]
      },
      "synchronous": false
    },
    "white_balance": {
      "description": "The gains that make the light's white grey, from the region's\nlightest part. Its result is the gains, also in\n`last_white_balance`; the preview takes them when a client sets its\nlook's `gains`.",
      "title": "Finds the white balance: a hardware job.",
      "forms": [
