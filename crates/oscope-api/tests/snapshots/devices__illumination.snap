  "actions": {
    "set_light": {
      "description": "`channel` on or off, at `intensity` from 0 to 1. It returns the light\nas applied: one that can't dim is at full intensity.",
      "title": "Sets a light.",
      "forms": [
        {
          "href": "/api/v1/illumination/set_light",
          "op": [
            "invokeaction"
          ]
        },
