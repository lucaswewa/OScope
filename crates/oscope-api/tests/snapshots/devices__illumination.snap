{
  "id": "urn:uuid:1e7949cb-9855-53ff-883f-24a5c824cc12",
  "title": "Illumination",
  "properties": {
    "capabilities": {
      "description": "What the lights are: their channels, and which can dim.",
      "title": "What the lights are: their channels, and which can dim.",
      "writeOnly": false,
      "readOnly": true,
      "type": "object",
      "properties": {
        "model": {
          "description": "The controller's maker and model, or `manual`.",
          "type": "string"
        },
        "channels": {
          "description": "Its channels.",
          "type": "array",
          "items": {
            "description": "One light.",
            "type": "object",
            "properties": {
              "name": {
                "description": "Its name, unique among the channels, such as `transmitted`.",
                "type": "string"
              },
              "kind": {
                "description": "Where it shines from.",
                "oneOf": [
                  {
                    "description": "Through the sample, from below: brightfield.",
                    "const": "transmitted",
                    "type": "string"
                  },
                  {
                    "description": "Onto the sample, through the objective or beside it.",
                    "const": "reflected",
                    "type": "string"
                  },
                  {
                    "description": "Anything else a controller offers.",
                    "const": "other",
                    "type": "string"
                  }
                ]
              },
              "dimmable": {
                "description": "Whether its intensity can be set. One that can't is on at full\nintensity, or off.",
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "kind",
              "dimmable"
            ]
          }
        }
      },
      "required": [
        "model",
        "channels"
      ],
      "forms": [
        {
          "href": "/api/v1/illumination/capabilities",
          "op": [
            "readproperty"
          ]
        }
      ]
    },
    "lights": {
      "description": "Each channel's state.",
      "title": "Each channel's state.",
      "writeOnly": false,
      "readOnly": true,
      "type": "array",
      "items": {
        "description": "A light's state when a frame was taken.",
        "type": "object",
        "properties": {
          "channel": {
            "description": "The channel, such as `transmitted`.",
            "type": "string"
          },
          "on": {
            "description": "Whether it was on.",
            "type": "boolean"
          },
          "intensity": {
            "description": "Its intensity, from 0 to 1.",
