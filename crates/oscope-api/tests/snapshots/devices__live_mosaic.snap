                "properties": {
                  "kind": {
                    "const": "newest",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "description": "Its edges fade into what is there, over `width_px` canvas pixels;\nwhere nothing is, it is drawn whole.",
                "type": "object",
                "properties": {
                  "width_px": {
                    "description": "How far in from its edges it fades, in canvas pixels.",
                    "type": "number"
                  },
                  "kind": {
                    "const": "feather",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "width_px"
                ]
              }
            ]
          },
          "counts": {
            "description": "How many frames became what.",
            "type": "object",
            "properties": {
              "drawn": {
                "description": "Drawn.",
                "type": "integer",
                "minimum": 0
              },
              "scans": {
                "description": "Of those drawn, a scan's.",
                "type": "integer",
                "minimum": 0
              },
              "blurred": {
                "description": "Blurred by the stage's moving.",
                "type": "integer",
                "minimum": 0
              },
              "same": {
                "description": "Showing a place drawn, and no sharper.",
                "type": "integer",
                "minimum": 0
              },
              "unplaced": {
                "description": "Without a position.",
                "type": "integer",
                "minimum": 0
              },
              "other": {
                "description": "Through another objective, or at another binning.",
                "type": "integer",
                "minimum": 0
              },
              "outside": {
                "description": "Off the canvas.",
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "description": "That failed to draw.",
                "type": "integer",
                "minimum": 0
              },
              "dropped": {
                "description": "A scan's frames not drawn, as too many were waiting.",
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "drawn",
              "scans",
              "blurred",
              "same",
              "unplaced",
              "other",
              "outside",
              "failed",
              "dropped"
            ]
          },
          "tiles": {
            "description": "Its tiles, at every level.",
            "type": "integer",
            "minimum": 0
          },
          "memory_mb": {
            "description": "The memory its tiles take, in MB.",
            "type": "number"
          },
          "generation": {
            "description": "Its generation: the preview stream tells a client of the tiles\nchanged since the one it last saw.",
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "mosaic",
          "drawing",
          "roaming",
          "levels",
          "tile",
          "blend",
          "counts",
          "tiles",
          "memory_mb",
          "generation"
        ]
      },
      "synchronous": false
    }
  },
  "description": "The live mosaic: a mosaic that builds as frames arrive (ADR-0026).\n\nFrom the live stream as the stage roams, gated by motion blur, place\nand sharpness, and from the scans' tiles as they are taken. Its tiles\nare at `/api/v1/mosaic/tiles/{level}/{col}/{row}`.",
  "forms": [
    {
      "href": "/api/v1/live_mosaic/properties",
      "op": [
        "readallproperties"
      ]
    },
    {
      "href": "/api/v1/live_mosaic/actions",
      "op": [
        "queryallactions"
      ]
    }
  ],
  "base": "http://127.0.0.1:8220/",
  "securityDefinitions": {
    "no_security": {
      "description": "No security",
      "scheme": "nosec"
    }
  },
  "security": "no_security",
  "@type": "saref:Function"
}
