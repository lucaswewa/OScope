  "title": "Preview",
  "properties": {
    "cpu_only": {
      "description": "Saved. For comparing them: both give the same pixels.",
      "title": "Makes previews on the CPU even when there is a GPU.",
      "writeOnly": false,
      "readOnly": false,
      "default": false,
      "type": "boolean",
      "forms": [
        {
          "href": "/api/v1/preview/cpu_only",
          "op": [
            "readproperty",
            "writeproperty"
          ]
        },
        {
          "href": "/api/v1/preview/cpu_only",
          "op": [
            "observeproperty",
            "unobserveproperty"
          ],
          "subprotocol": "sse"
        },
        {
          "href": "ws://127.0.0.1:8220/api/v1/preview/ws",
          "op": [
            "observeproperty"
          ]
        }
      ],
      "observable": true
    },
    "defaults": {
      "description": "Saved. Clients that didn't ask take a change at once.",
      "title": "What a client gets unless it asks otherwise.",
      "writeOnly": false,
      "readOnly": false,
      "default": {
        "width": 1920,
        "height": 1080,
        "quality": 80,
        "max_fps": 30.0
      },
      "type": "object",
      "properties": {
        "width": {
          "description": "The viewport's width, in pixels.",
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "description": "Its height.",
          "type": "integer",
          "minimum": 0
        },
        "quality": {
          "description": "The JPEG quality, from 1 to 100.",
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "max_fps": {
          "description": "The most frames a second. The camera's rate is the most it gets.",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height",
        "quality",
        "max_fps"
      ],
      "forms": [
        {
          "href": "/api/v1/preview/defaults",
          "op": [
            "readproperty",
            "writeproperty"
          ]
        },
        {
          "href": "/api/v1/preview/defaults",
          "op": [
            "observeproperty",
            "unobserveproperty"
          ],
          "subprotocol": "sse"
        },
        {
          "href": "ws://127.0.0.1:8220/api/v1/preview/ws",
          "op": [
            "observeproperty"
          ]
        }
      ],
      "observable": true,
      "additionalProperties": false
    },
    "gpu": {
      "description": "Whether there is a GPU to make previews on.",
      "title": "Whether there is a GPU to make previews on.",
      "writeOnly": false,
      "readOnly": true,
      "type": "boolean",
      "forms": [
        {
          "href": "/api/v1/preview/gpu",
          "op": [
            "readproperty"
          ]
        }
      ]
    },
    "look": {
      "description": "Saved.",
      "title": "How previews look: the levels, the tone curve and white balance.",
      "writeOnly": false,
      "readOnly": false,
      "default": {
        "black": 0.0,
        "white": 1.0,
        "gamma": null,
        "gains": [
          1.0,
          1.0,
          1.0
        ]
      },
      "type": "object",
      "properties": {
        "black": {
          "description": "The level shown as black, from 0 to 1, once the camera's black level\nis taken off.",
          "type": "number"
        },
        "white": {
          "description": "The level shown as white: above black.",
          "type": "number"
        },
        "gamma": {
          "description": "The display's gamma, such as 2.2; none for sRGB's curve.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "gains": {
          "description": "Red, green and blue's white-balance gains.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "required": [
        "black",
        "white",
        "gains"
      ],
      "forms": [
        {
          "href": "/api/v1/preview/look",
          "op": [
            "readproperty",
