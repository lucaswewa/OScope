                "additionalProperties": false
              }
            },
            "outputs": {
              "description": "What it gives.",
              "type": "array",
              "items": {
                "description": "One of a recipe's outputs.",
                "type": "object",
                "properties": {
                  "name": {
                    "description": "Its name.",
                    "type": "string"
                  },
                  "from": {
                    "description": "The node's output, or recipe input, it gives: `node.port`.",
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "from"
                ],
                "additionalProperties": false
              }
            },
            "layout": {
              "description": "Where an editor drew each node, by its ID: `[x, y]`, in its own\nunits. The engine ignores it (W7.2).",
