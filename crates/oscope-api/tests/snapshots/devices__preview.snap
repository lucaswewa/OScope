            "observeproperty"
          ]
        }
      ],
      "observable": true,
      "additionalProperties": false
    },
    "sessions": {
      "description": "The sessions open now, and how each is doing.",
      "title": "The sessions open now, and how each is doing.",
      "writeOnly": false,
      "readOnly": true,
      "type": "array",
      "items": {
        "description": "How a client's session is doing.",
        "type": "object",
        "properties": {
          "session": {
            "description": "The session's number, from 1 since the server started.",
            "type": "integer",
            "minimum": 0
          },
          "fps": {
            "description": "Messages sent in the last second.",
            "type": "number"
          },
          "latency_ms": {
            "description": "The last second's mean time from the end of a frame's exposure to its\nmessage being ready, in ms.",
            "type": "number"
          },
          "bytes_per_s": {
            "description": "Bytes sent in the last second.",
            "type": "number"
          },
          "sent": {
            "description": "Messages sent.",
            "type": "integer",
            "minimum": 0
          },
          "dropped": {
            "description": "Frames it missed: messages replaced before the client took them, and\nframes skipped while it was behind on acknowledging.",
            "type": "integer",
            "minimum": 0
          },
          "quality": {
            "description": "The quality it gets now, after adapting to its link.",
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "width": {
            "description": "The width of its latest preview.",
            "type": "integer",
            "minimum": 0
          },
          "height": {
            "description": "Its height.",
            "type": "integer",
            "minimum": 0
          },
          "gpu": {
            "description": "Whether the GPU made it.",
            "type": "boolean"
          }
        },
        "required": [
          "session",
          "fps",
          "latency_ms",
          "bytes_per_s",
          "sent",
          "dropped",
          "quality",
          "width",
          "height",
          "gpu"
        ]
      },
      "forms": [
        {
          "href": "/api/v1/preview/sessions",
          "op": [
            "readproperty"
          ]
        }
      ]
    }
  },
  "actions": {},
  "description": "Live previews: the camera's frames as JPEGs, each client's the size of\nits viewport, through a binary WebSocket (ADR-0014).",
  "links": [
    {
      "href": "/api/v1/preview/stream",
      "type": "application/octet-stream",
      "rel": "alternate",
      "subprotocol": "websocket",
      "parameters": {
        "description": "What a client asks for, as a JSON text message. Each message replaces\nthe last, and what it leaves out takes the `defaults` setting's value.",
        "type": "object",
        "properties": {
          "width": {
            "description": "The viewport's width, in pixels.",
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "height": {
            "description": "Its height.",
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "roi": {
            "description": "The sensor's pixels to show, in full-sensor coordinates: the whole\nframe when not given, or when it misses the frame.",
            "oneOf": [
              {
                "description": "A rectangle of whole pixels: the column and row of its top-left pixel, and\nits size.",
                "type": "object",
                "properties": {
                  "x": {
                    "description": "The column of its left edge.",
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "description": "The row of its top edge.",
                    "type": "integer",
                    "minimum": 0
                  },
                  "width": {
                    "description": "Its width in pixels.",
                    "type": "integer",
                    "minimum": 0
                  },
                  "height": {
                    "description": "Its height in pixels.",
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "quality": {
            "description": "The JPEG quality, from 1 to 100.",
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "null"
              }
            ]
          },
          "max_fps": {
            "description": "The most frames a second.",
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "ack": {
            "description": "The number of the next message the client is ready for: one more\nthan the last it has shown, and 0 before the first. Once a client\nsends it, it has at most 2 messages it hasn't shown, so that no socket\nbuffer holds stale frames for it (ADR-0014).",
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "stats": {
            "description": "Live statistics to send with the previews, at most 10 times a\nsecond (ADR-0035): none when not given.",
            "oneOf": [
              {
                "description": "What a client asks to be measured.",
                "type": "object",
                "properties": {
                  "roi": {
                    "description": "The sensor's pixels to give statistics for, in full-sensor\ncoordinates, which the focus value is also measured over: the\npreview's region when not given.",
                    "oneOf": [
                      {
                        "description": "A rectangle of whole pixels: the column and row of its top-left pixel, and\nits size.",
                        "type": "object",
                        "properties": {
                          "x": {
                            "description": "The column of its left edge.",
                            "type": "integer",
                            "minimum": 0
                          },
                          "y": {
                            "description": "The row of its top edge.",
                            "type": "integer",
                            "minimum": 0
                          },
                          "width": {
                            "description": "Its width in pixels.",
                            "type": "integer",
                            "minimum": 0
                          },
                          "height": {
                            "description": "Its height in pixels.",
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "width",
                          "height"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "profile": {
                    "description": "A line to profile, in full-sensor coordinates.",
                    "oneOf": [
                      {
                        "description": "A line across the sensor, in full-sensor coordinates.",
                        "type": "object",
                        "properties": {
                          "from": {
                            "description": "Where it starts: x and y.",
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "maxItems": 2,
                            "minItems": 2
                          },
                          "to": {
                            "description": "Where it ends.",
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "maxItems": 2,
                            "minItems": 2
                          }
                        },
                        "required": [
                          "from",
                          "to"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "bins": {
                    "description": "The histograms' bins, from 1 to 4096.",
                    "default": 256,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "mask": {
                    "description": "Whether to send the saturation mask.",
                    "default": true,
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "forms": [
    {
      "href": "/api/v1/preview/properties",
      "op": [
        "readallproperties",
