                    "type": "string"
                  },
                  "inputs": {
                    "description": "What it takes, each named and typed: `input.<name>` in its edges.",
                    "default": [],
                    "type": "array",
                    "items": {
                      "description": "A node's input or output, or a recipe's: a name and a type.",
                      "type": "object",
                      "properties": {
                        "name": {
                          "description": "Its name: letters, digits and `_`.",
                          "type": "string"
                        },
                        "type": {
                          "description": "Its values' type.",
                          "oneOf": [
                            {
                              "description": "An image of 32-bit floats, in memory or on the GPU.",
                              "const": "image",
                              "type": "string"
                            },
                            {
                              "description": "Images of one shape: a z-stack, a time series or a volume.",
                              "const": "stack",
                              "type": "string"
                            },
                            {
                              "description": "A binary mask, a byte a pixel.",
                              "const": "mask",
                              "type": "string"
                            },
                            {
                              "description": "A table: named columns, and rows.",
                              "const": "table",
                              "type": "string"
                            },
                            {
                              "description": "Shapes, as GeoJSON.",
                              "const": "geometry",
                              "type": "string"
                            },
                            {
                              "description": "A number, or any JSON.",
                              "const": "json",
                              "type": "string"
                            },
                            {
                              "description": "A fragment of a report.",
                              "const": "report",
                              "type": "string"
                            }
                          ]
                        },
                        "optional": {
                          "description": "For a node's input: whether it may be left without an edge.",
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "name",
                        "type"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "nodes": {
                    "description": "Its nodes.",
                    "type": "array",
                    "items": {
                      "description": "A node in a recipe.",
                      "type": "object",
                      "properties": {
                        "id": {
                          "description": "Its ID in the recipe: letters, digits and `_`, and not `input`.",
                          "type": "string"
                        },
                        "node": {
                          "description": "Which node it is: its descriptor's ID.",
                          "type": "string"
                        },
                        "version": {
                          "description": "The node's version the recipe was made for: the registry's must be\nthe same, when given.",
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "params": {
                          "description": "Its parameters, which the node's schema checks.",
                          "default": {}
                        }
                      },
                      "required": [
                        "id",
                        "node"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "edges": {
                    "description": "Its edges.",
                    "default": [],
                    "type": "array",
                    "items": {
                      "description": "An edge: from a node's output, or a recipe input, to a node's input, each\n`node.port`.",
                      "type": "object",
                      "properties": {
                        "from": {
                          "description": "The output: `blur.image`, or `input.image` for a recipe input.",
                          "type": "string"
                        },
                        "to": {
                          "description": "The input: `threshold.image`.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "from",
                        "to"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "outputs": {
                    "description": "What it gives.",
                    "type": "array",
                    "items": {
                      "description": "One of a recipe's outputs.",
                      "type": "object",
                      "properties": {
                        "name": {
                          "description": "Its name.",
                          "type": "string"
                        },
                        "from": {
                          "description": "The node's output, or recipe input, it gives: `node.port`.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "from"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "layout": {
                    "description": "Where an editor drew each node, by its ID: `[x, y]`, in its own\nunits. The engine ignores it (W7.2).",
                    "type": "object",
                    "additionalProperties": {
                      "items": {
                        "type": "number"
                      },
                      "maxItems": 2,
                      "minItems": 2,
                      "type": "array"
                    }
                  }
                },
                "required": [
                  "format",
                  "nodes",
                  "outputs"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "output": {
        "title": "set_live_recipe_output",
        "oneOf": [
          {
            "description": "What a live recipe was checked to take.",
            "type": "object",
            "properties": {
              "steps": {
                "description": "Its steps, in order.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "time_ms": {
                "description": "Its time on an RGB image the default viewport's size, in ms.",
                "type": "number"
              },
              "step_ms": {
                "description": "Each step's own time in that run, in ms, by its ID (W7.3). Steps\non separate branches may run at once, so they can add up to more.",
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "width": {
                "description": "That image's width.",
                "type": "integer",
                "minimum": 0
              },
              "height": {
                "description": "Its height.",
                "type": "integer",
                "minimum": 0
              },
              "budget_ms": {
                "description": "The budget it was checked against, in ms.",
                "type": "number"
              }
            },
            "required": [
              "steps",
              "time_ms",
              "step_ms",
              "width",
              "height",
              "budget_ms"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "synchronous": false
    }
  },
  "description": "Live previews: the camera's frames as JPEGs, each client's the size of\nits viewport, through a binary WebSocket (ADR-0014).",
  "links": [
    {
      "href": "/api/v1/preview/stream",
      "type": "application/octet-stream",
      "rel": "alternate",
      "subprotocol": "websocket",
      "parameters": {
        "description": "What a client asks for, as a JSON text message. Each message replaces\nthe last, and what it leaves out takes the `defaults` setting's value.",
        "type": "object",
        "properties": {
          "width": {
            "description": "The viewport's width, in pixels.",
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "height": {
            "description": "Its height.",
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "roi": {
            "description": "The sensor's pixels to show, in full-sensor coordinates: the whole\nframe when not given, or when it misses the frame.",
            "oneOf": [
              {
                "description": "A rectangle of whole pixels: the column and row of its top-left pixel, and\nits size.",
                "type": "object",
                "properties": {
                  "x": {
                    "description": "The column of its left edge.",
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "description": "The row of its top edge.",
                    "type": "integer",
                    "minimum": 0
                  },
                  "width": {
                    "description": "Its width in pixels.",
                    "type": "integer",
                    "minimum": 0
                  },
                  "height": {
                    "description": "Its height in pixels.",
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "quality": {
            "description": "The JPEG quality, from 1 to 100.",
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "null"
              }
            ]
          },
          "max_fps": {
            "description": "The most frames a second.",
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "ack": {
            "description": "The number of the next message the client is ready for: one more\nthan the last it has shown, and 0 before the first. Once a client\nsends it, it has at most 2 messages it hasn't shown, so that no socket\nbuffer holds stale frames for it (ADR-0014).",
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "stats": {
            "description": "Live statistics to send with the previews, at most 10 times a\nsecond (ADR-0035): none when not given.",
            "oneOf": [
              {
                "description": "What a client asks to be measured.",
                "type": "object",
                "properties": {
                  "roi": {
                    "description": "The sensor's pixels to give statistics for, in full-sensor\ncoordinates, which the focus value is also measured over: the\npreview's region when not given.",
                    "oneOf": [
                      {
                        "description": "A rectangle of whole pixels: the column and row of its top-left pixel, and\nits size.",
                        "type": "object",
                        "properties": {
                          "x": {
                            "description": "The column of its left edge.",
                            "type": "integer",
                            "minimum": 0
                          },
                          "y": {
                            "description": "The row of its top edge.",
                            "type": "integer",
                            "minimum": 0
                          },
                          "width": {
                            "description": "Its width in pixels.",
                            "type": "integer",
                            "minimum": 0
                          },
                          "height": {
                            "description": "Its height in pixels.",
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "width",
                          "height"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "profile": {
                    "description": "A line to profile, in full-sensor coordinates.",
                    "oneOf": [
                      {
                        "description": "A line across the sensor, in full-sensor coordinates.",
                        "type": "object",
                        "properties": {
                          "from": {
                            "description": "Where it starts: x and y.",
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "maxItems": 2,
                            "minItems": 2
                          },
                          "to": {
                            "description": "Where it ends.",
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "maxItems": 2,
                            "minItems": 2
                          }
                        },
                        "required": [
                          "from",
                          "to"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "bins": {
                    "description": "The histograms' bins, from 1 to 4096.",
                    "default": 256,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "mask": {
                    "description": "Whether to send the saturation mask.",
                    "default": true,
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "mosaic": {
            "description": "Whether to send the live mosaic's tiles changed since the last\nmessage, as a block with each message that has some (ADR-0026).",
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "forms": [
    {
      "href": "/api/v1/preview/properties",
      "op": [
        "readallproperties",
        "writemultipleproperties"
      ]
    },
    {
      "href": "/api/v1/preview/properties",
      "op": [
        "observeallproperties",
        "unobserveallproperties"
      ],
      "subprotocol": "sse"
    },
    {
      "href": "/api/v1/preview/actions",
      "op": [
        "queryallactions"
      ]
    }
  ],
  "base": "http://127.0.0.1:8220/",
  "securityDefinitions": {
    "no_security": {
      "description": "No security",
      "scheme": "nosec"
    }
  },
  "security": "no_security",
  "@type": "saref:Function"
}
