        ],
        "additionalProperties": false
      },
      "output": {
        "description": "A reference, captured.",
        "title": "capture_reference_output",
        "type": "object",
        "properties": {
          "name": {
            "description": "Its name, which `io.reference` takes.",
            "type": "string"
          },
          "width": {
            "description": "Its width, in pixels.",
