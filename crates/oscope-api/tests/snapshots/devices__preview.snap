            "minimum": 0
          },
          "height": {
            "description": "Its height.",
            "type": "integer",
            "minimum": 0
          },
          "frames": {
            "description": "The frames it is the mean of.",
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "width",
          "height",
          "frames"
        ]
      },
      "synchronous": false
    },
    "set_live_recipe": {
      "description": "Sets the live recipe, run on each preview after demosaicing, binning\nand the black level, in place of the look; or none.\n\nIt is checked first: every step runs live; it takes `image`, and\nperhaps `region`, and gives `image`, the same size, in display\nvalues; and it takes at most `recipe_budget_ms` on an image the\ndefault viewport's size. Refused (400), saying why, otherwise.",
      "title": "Sets the live recipe, run on each preview after demosaicing, binning",
      "forms": [
        {
          "href": "/api/v1/preview/set_live_recipe",
          "op": [
            "invokeaction"
          ]
        },
        {
