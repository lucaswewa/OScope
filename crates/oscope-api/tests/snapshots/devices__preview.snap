  "actions": {
    "capture_reference": {
      "description": "Captures a reference, such as a flat field or a dark frame: the\nmean of the camera's next `frames` frames (4 unless given, 64 at\nmost), whole, in linear light, at most 1024 pixels wide.\n\nIt is kept as `{data}/references/{name}.tiff`, for `io.reference`.\nThe live recipe, if one is set, is made again, to read it.",
      "title": "Captures a reference, such as a flat field or a dark frame: the",
      "forms": [
        {
          "href": "/api/v1/preview/capture_reference",
          "op": [
            "invokeaction"
          ]
        },
        {
          "href": "/api/v1/action_invocations/{id}",
          "op": [
            "queryaction",
            "cancelaction"
          ]
        }
      ],
      "uriVariables": {
        "id": {
          "title": "Invocation ID",
          "format": "uuid",
          "type": "string"
        }
      },
      "input": {
        "title": "capture_reference_input",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "frames": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
