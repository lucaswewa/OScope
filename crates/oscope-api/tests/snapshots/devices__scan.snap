                "description": "The stack taken at each tile, or `None` for one plane.",
                "oneOf": [
                  {
                    "description": "A stack of planes through each tile's z.",
                    "type": "object",
                    "properties": {
                      "below_um": {
                        "description": "How far below the tile's z it starts, in µm.",
                        "type": "number"
                      },
                      "above_um": {
                        "description": "How far above the tile's z it may end.",
                        "type": "number"
                      },
                      "step_um": {
                        "description": "The step between planes.",
                        "type": "number"
                      }
                    },
                    "required": [
                      "below_um",
                      "above_um",
                      "step_um"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tiles": {
                "description": "The tiles, in order.",
                "type": "array",
                "items": {
                  "description": "One tile: where one frame, or one stack, is taken.",
                  "type": "object",
                  "properties": {
                    "index": {
                      "description": "Its place in the order, from 0.",
                      "type": "integer",
                      "minimum": 0
                    },
                    "row": {
                      "description": "Its row in the grid, from the least y; 0 for a position.",
                      "type": "integer",
                      "minimum": 0
                    },
                    "column": {
                      "description": "Its column in the grid, from the least x; a position's place in its\nlist.",
                      "type": "integer",
