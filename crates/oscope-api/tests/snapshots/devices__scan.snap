                              "required": [
                                "x",
                                "y"
                              ]
                            },
                            "coefficients": {
                              "description": "What [`FocusMap::z_at`] evaluates: a plane's z at the centre, then its\nslopes along x and y in µm a mm; or a spline's weight for each used\npoint, then its plane's three.",
                              "type": "array",
                              "items": {
                                "type": "number"
                              }
                            }
