                                  "type": "number"
                                }
                              },
                              "required": [
                                "x_um",
                                "y_um",
                                "z_um"
                              ]
                            }
                          },
                          "rms_um": {
                            "description": "The root mean square of how far the surface fitted to the others\nmisses each used point, in µm: how well the map foretells focus where\nit wasn't measured. `None` with only three points.",
                            "oneOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "centre": {
                            "description": "Where coordinates are taken from, in µm: the used points' middle.\nThey are taken in mm.",
                            "type": "object",
                            "properties": {
                              "x": {
                                "description": "Across.",
                                "type": "number"
                              },
                              "y": {
                                "description": "Down, in an image.",
                                "type": "number"
                              }
                            },
                            "required": [
