    "progress": {
      "description": "Its plan, the tiles done, each where it was taken, and how it stands.\nNone before the first.",
      "title": "The latest scan's progress.",
      "writeOnly": false,
      "readOnly": true,
      "oneOf": [
        {
          "description": "A scan's progress: its plan, the tiles done, and how it stands.",
          "type": "object",
          "properties": {
            "job": {
              "description": "The scan's job.",
              "format": "uuid",
              "type": "string"
            },
            "plan": {
              "description": "Its plan.",
              "type": "object",
              "properties": {
                "pattern": {
                  "description": "The pattern.",
                  "oneOf": [
                    {
                      "description": "Rows from the least y, each from its least x.",
                      "const": "raster",
                      "type": "string"
                    },
                    {
                      "description": "Rows from the least y, each the other way from the last.",
                      "const": "snake",
                      "type": "string"
                    },
                    {
                      "description": "One position, a stack through it.",
                      "const": "z_scan",
                      "type": "string"
                    },
                    {
                      "description": "A snake, a stack at each tile.",
                      "const": "tiled_stack",
                      "type": "string"
                    },
                    {
                      "description": "Positions, in the order given.",
                      "const": "positions",
                      "type": "string"
                    },
                    {
                      "description": "Positions an extension's workflow planned (ADR-0025).",
                      "const": "workflow",
                      "type": "string"
                    }
                  ]
                },
                "motion": {
                  "description": "How the stage moves through it.",
                  "oneOf": [
                    {
                      "description": "It stops at each tile, settles, and takes its frames: M1's.",
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "stop_and_go",
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    {
                      "description": "Reserved for M3 (D14): each row swept at a constant speed, frames\ntriggered at the tiles' positions. The engine refuses it until then.",
                      "type": "object",
                      "properties": {
                        "speed_um_s": {
                          "description": "The sweep's speed, in µm/s.",
                          "type": "number"
                        },
                        "kind": {
                          "const": "continuous",
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "speed_um_s"
                      ]
                    }
                  ],
                  "default": {
                    "kind": "stop_and_go"
                  }
                },
                "field": {
                  "description": "The field that spaced the tiles.",
                  "type": "object",
