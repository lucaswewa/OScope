                    "const": "workflow",
                    "type": "string"
                  }
                ]
              },
              "motion": {
                "description": "How the stage moves through it.",
                "oneOf": [
                  {
                    "description": "It stops at each tile, settles, and takes its frames: M1's.",
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "stop_and_go",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  {
                    "description": "Reserved for M3 (D14): each row swept at a constant speed, frames\ntriggered at the tiles' positions. The engine refuses it until then.",
                    "type": "object",
