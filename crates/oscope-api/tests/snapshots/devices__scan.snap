                    ]
                  },
                  {
                    "description": "By autofocus, as the scan reaches every `every`-th tile from the\nfirst; the tiles between at the last z found (P36).",
                    "type": "object",
                    "properties": {
                      "every": {
                        "description": "How many tiles each autofocus serves, at least 1.",
                        "type": "integer",
                        "minimum": 0
                      },
                      "kind": {
                        "const": "autofocus",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "every"
                    ]
                  }
                ]
              },
