                      "height"
                    ]
                  },
                  "overlap": {
                    "description": "The share of a cell's width, and of its height, that its neighbours\nalong x, and along y, overlap.",
                    "type": "number"
                  },
                  "step_um": {
                    "description": "The grid's steps along x and y, in µm: the cell, less the overlap.",
                    "type": "object",
                    "properties": {
                      "width": {
                        "description": "Along x.",
