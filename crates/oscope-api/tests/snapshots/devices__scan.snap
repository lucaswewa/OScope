        "title": "plan_input",
        "type": "object",
        "properties": {
          "request": {
            "description": "A scan, as a client asks for it.",
            "type": "object",
            "properties": {
              "pattern": {
                "description": "`raster`, `snake`, `tiled_stack`, `z_scan` or `positions`, or an\nextension's workflow by name.",
                "type": "string"
              },
              "region": {
                "description": "Where a raster, a snake or a tiled z-stack goes.",
                "oneOf": [
                  {
                    "description": "Where a scan goes, in stage µm. In JSON, an object of one key, its kind:\n`{\"rect\": {\"origin\", \"size\"}}`, `{\"polygon\": {\"corners\"}}` or\n`{\"mask\": {…}}`.",
                    "oneOf": [
                      {
                        "description": "A rectangle, square with the stage, its edges inside.",
                        "type": "object",
                        "properties": {
                          "rect": {
                            "description": "An axis-aligned rectangle: its corner of least x and y, and its size.",
                            "type": "object",
                            "properties": {
                              "origin": {
                                "description": "The corner of least x and y: the top left, in an image.",
                                "type": "object",
                                "properties": {
                                  "x": {
                                    "description": "Across.",
                                    "type": "number"
                                  },
                                  "y": {
                                    "description": "Down, in an image.",
                                    "type": "number"
                                  }
                                },
                                "required": [
                                  "x",
                                  "y"
                                ]
                              },
                              "size": {
                                "description": "Its size.",
                                "type": "object",
                                "properties": {
                                  "width": {
                                    "description": "Along x.",
                                    "type": "number"
                                  },
                                  "height": {
                                    "description": "Along y.",
                                    "type": "number"
                                  }
                                },
                                "required": [
                                  "width",
                                  "height"
                                ]
                              }
                            },
                            "required": [
                              "origin",
                              "size"
                            ]
                          }
                        },
                        "required": [
                          "rect"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "description": "A polygon, by its corners in order: it closes itself. Its edges are\ninside, and its inside is by the even-odd rule, so a polygon that\ncrosses itself leaves out what it goes round twice.",
                        "type": "object",
                        "properties": {
                          "polygon": {
                            "type": "object",
                            "properties": {
                              "corners": {
                                "description": "Its corners.",
