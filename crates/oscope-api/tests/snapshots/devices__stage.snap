              "description": "The least position.",
              "type": "number"
            },
            "max": {
              "description": "The greatest position.",
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ]
        },
        "max_speed": {
          "description": "The fastest speed along a move's path.",
          "type": "number"
        },
        "default_speed": {
          "description": "The speed of a move that names none.",
          "type": "number"
        },
        "homing": {
          "description": "Whether it can home, on its switches.",
          "type": "boolean"
        },
        "encoders": {
          "description": "Whether its positions come from linear encoders, rather than from\ncounted steps.",
          "type": "boolean"
        },
        "trigger_output": {
          "description": "Whether it has a trigger output, to fire a camera at positions (D20).",
          "type": "boolean"
        },
        "report_interval": {
          "description": "How often it reports its position.",
          "type": "number"
        }
