      "type": "object",
      "properties": {
        "model": {
          "description": "The controller's maker and model.",
          "type": "string"
        },
        "x": {
          "description": "x's soft limits.",
          "type": "object",
          "properties": {
            "min": {
              "description": "The least position.",
              "type": "number"
            },
            "max": {
              "description": "The greatest position.",
              "type": "number"
            }
          },
