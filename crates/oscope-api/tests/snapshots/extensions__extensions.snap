  "title": "Extensions",
  "properties": {
    "host": {
      "description": "The extension API this OScope offers, and its platform.",
      "title": "The extension API this OScope offers, and its platform.",
      "writeOnly": false,
      "readOnly": true,
      "type": "object",
      "properties": {
        "api": {
          "description": "The extension API it offers, which a package's `oscope-api` range\nmust match.",
          "type": "string"
        },
        "platform": {
          "description": "Its platform, which a Rust package needs a library for.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "api"
      ],
      "forms": [
        {
          "href": "/api/v1/extensions/host",
          "op": [
            "readproperty"
          ]
        }
      ]
    },
    "installed": {
      "description": "Each with its manifest, the SHA-256 of its package, the version this\nstart loaded and the one the next start will.",
      "title": "The installed extensions, by ID.",
      "writeOnly": false,
      "readOnly": true,
      "type": "array",
      "items": {
        "description": "An installed extension, as the `extensions` Thing describes it.",
        "type": "object",
        "properties": {
          "manifest": {
            "description": "The installed version's manifest.",
            "type": "object",
            "properties": {
              "id": {
                "description": "Its ID, in reverse DNS: at least two dotted names, in lower case.",
                "type": "string"
              },
              "name": {
                "description": "Its name, for people.",
                "type": "string"
              },
              "version": {
                "description": "Its version.",
                "type": "string"
              },
              "license": {
                "description": "Its licence, as an SPDX expression such as `MIT`.",
                "type": "string"
              },
              "publisher": {
                "description": "Who publishes it.",
                "type": "string"
              },
              "description": {
                "description": "What it does.",
                "default": "",
                "type": "string"
              },
              "oscope-api": {
                "description": "The versions of the extension API it works with, such as `^1.0`.",
                "type": "string"
              },
              "kind": {
                "description": "What it is written in.",
                "oneOf": [
                  {
                    "description": "A native library behind the Rust SDK's C ABI (ADR-0019).",
                    "const": "rust",
                    "type": "string"
                  },
                  {
                    "description": "A Python package, run in a worker of its own (ADR-0020).",
                    "const": "python",
                    "type": "string"
                  }
                ]
              },
              "assets": {
                "description": "The files in the package it uses as they are: panel schemas and\nreport templates.",
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "provides": {
                "description": "What it adds to OScope: names, by contribution.",
                "type": "object",
                "additionalProperties": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "rust": {
                "description": "A Rust package's libraries.",
                "oneOf": [
                  {
                    "description": "A Rust package's libraries.",
                    "type": "object",
                    "properties": {
                      "libraries": {
                        "description": "For each platform it is built for, its library's path in the package.",
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "libraries"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "python": {
                "description": "A Python package's environment and entry point.",
                "oneOf": [
                  {
                    "description": "A Python package's environment and entry point (ADR-0020).",
                    "type": "object",
                    "properties": {
                      "requires-python": {
                        "description": "The Python versions it needs, such as `>=3.12`.",
                        "type": "string"
                      },
                      "dependencies": {
                        "description": "The packages it needs, as uv takes them, such as `numpy>=2`.",
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "entry": {
                        "description": "The module OScope imports, such as `emboss.nodes`.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "requires-python",
                      "entry"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "name",
              "version",
              "license",
              "publisher",
              "oscope-api",
              "kind",
              "provides"
            ],
            "additionalProperties": false
          },
          "sha256": {
            "description": "The SHA-256 of the package it came from, in hex.",
            "type": "string"
          },
          "enabled": {
            "description": "Whether it is enabled: the next start loads it, if it can.",
            "type": "boolean"
          },
          "uninstalled": {
            "description": "Whether it is uninstalled: the next start removes its files.",
