                ],
                "additionalProperties": false
              },
              "sha256": {
                "description": "The SHA-256 of the package it came from, in hex.",
                "type": "string"
              },
              "enabled": {
                "description": "Whether it is enabled: the next start loads it, if it can.",
                "type": "boolean"
              },
              "uninstalled": {
                "description": "Whether it is uninstalled: the next start removes its files.",
                "type": "boolean"
              },
              "loaded": {
                "description": "The version this start loaded, if it loaded it.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "next": {
                "description": "The version the next start loads, if it will.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "problem": {
                "description": "Why the next start can't load it, though it is enabled.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "manifest",
              "sha256",
              "enabled",
              "uninstalled"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "synchronous": false
    }
  },
  "events": {
    "changed": {
      "description": "Its ID.",
      "title": "An extension was installed, enabled, disabled or uninstalled.",
      "forms": [
        {
          "href": "/api/v1/extensions/changed",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "subprotocol": "sse"
        },
        {
          "href": "ws://testserver/api/v1/extensions/ws",
          "op": [
            "subscribeevent"
          ]
        }
      ],
      "data": {
        "type": "string"
      }
    }
  },
  "description": "The extensions: packages that add processing nodes, drivers, workflows,\npanels, importers, exporters and reports (ADR-0018). They load when the\nserver starts, so each change here waits for the next start: `system`'s\n`restart`.\n\nInstall a package by posting it to `install`, as the request's body.",
  "forms": [
    {
      "href": "/api/v1/extensions/properties",
      "op": [
        "readallproperties"
      ]
    },
    {
      "href": "/api/v1/extensions/actions",
      "op": [
        "queryallactions"
      ]
    },
    {
      "href": "/api/v1/extensions/events",
      "op": [
        "subscribeallevents",
        "unsubscribeallevents"
      ],
      "subprotocol": "sse"
    }
  ],
  "base": "http://testserver/",
  "securityDefinitions": {
    "no_security": {
      "description": "No security",
      "scheme": "nosec"
    }
  },
  "security": "no_security",
  "@type": "saref:Function"
}
