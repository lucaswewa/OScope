  "title": "Projects",
  "properties": {},
  "actions": {
    "annotate": {
      "description": "On a project's acquisition or result, in layer `layer`, made if need\nbe: a GeoJSON Feature in µm, which replaces the one with its `id`, or\nwith none is new. The feature as kept, with its ID.",
      "title": "Keeps an annotation.",
      "forms": [
        {
          "href": "/api/v1/projects/annotate",
          "op": [
            "invokeaction"
          ]
        },
        {
          "href": "/api/v1/action_invocations/{id}",
          "op": [
            "queryaction",
            "cancelaction"
          ]
        }
      ],
      "uriVariables": {
        "id": {
          "title": "Invocation ID",
          "format": "uuid",
          "type": "string"
        }
      },
      "input": {
        "title": "annotate_input",
        "type": "object",
        "properties": {
          "project": {
            "description": "A project: a folder of data on disk (P28).",
            "format": "uuid",
            "type": "string"
          },
          "kind": {
            "description": "The kinds of record in a project.",
            "oneOf": [
              {
                "description": "Acquisitions.",
                "const": "acquisition",
                "type": "string"
              },
              {
                "description": "Results.",
                "const": "result",
                "type": "string"
              },
              {
                "description": "Reports.",
                "const": "report",
                "type": "string"
              }
            ]
          },
          "record": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "feature": {
            "description": "A shape, with its ID and its properties, which `name` names.",
            "type": "object",
            "properties": {
              "id": {
                "description": "Its ID, unique in its record: given when it is first kept.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "geometry": {
                "description": "Its shape.",
                "oneOf": [
                  {
                    "description": "A point: `[x, y]`, or `[x, y, z]` in a volume.",
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "Point",
                        "type": "string"
                      },
                      "coordinates": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "required": [
                      "type",
                      "coordinates"
                    ]
                  },
                  {
                    "description": "A line through two points or more.",
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "LineString",
                        "type": "string"
                      },
                      "coordinates": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    "required": [
                      "type",
                      "coordinates"
                    ]
                  },
                  {
                    "description": "An area: its outer ring, then its holes, each of four positions or\nmore, its last the same as its first.",
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "Polygon",
                        "type": "string"
                      },
                      "coordinates": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    },
                    "required": [
                      "type",
                      "coordinates"
                    ]
                  }
                ]
              },
              "properties": {
                "description": "What is said of it: its `name`, for one.",
                "default": {},
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "geometry"
            ]
          }
        },
        "required": [
          "project",
          "kind",
          "record",
          "layer",
          "feature"
        ],
        "additionalProperties": false
      },
      "output": {
        "description": "A shape, with its ID and its properties, which `name` names.",
        "title": "annotate_output",
        "type": "object",
        "properties": {
          "id": {
            "description": "Its ID, unique in its record: given when it is first kept.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "geometry": {
            "description": "Its shape.",
            "oneOf": [
              {
                "description": "A point: `[x, y]`, or `[x, y, z]` in a volume.",
                "type": "object",
