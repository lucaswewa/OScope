              },
              {
                "type": "null"
              }
            ]
          },
          "metadata": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "output": {
        "description": "A project: one slide or one experiment, holding acquisitions, results\nand reports. The Gallery shows each as a card.",
        "title": "create_output",
        "type": "object",
        "properties": {
          "id": {
            "description": "Its ID, which is also its folder's name.",
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "description": "Its name, which may change.",
            "type": "string"
          },
          "sample": {
            "description": "The sample: what is on the slide.",
            "default": "",
            "type": "string"
          },
          "tags": {
            "description": "Its tags, sorted, each once.",
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner": {
            "description": "Who made it.",
            "default": "",
            "type": "string"
          },
          "created": {
            "description": "When it was made.",
            "format": "date-time",
            "type": "string"
          },
          "modified": {
            "description": "When it, or anything in it, last changed.",
            "format": "date-time",
            "type": "string"
          },
          "metadata": {
            "description": "Anything else, as the app or a workflow keeps it.",
            "default": {},
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "name",
          "created",
          "modified"
        ]
      },
      "synchronous": false
    },
