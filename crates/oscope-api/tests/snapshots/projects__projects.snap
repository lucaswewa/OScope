                  "type": {
                    "const": "Point",
                    "type": "string"
                  },
                  "coordinates": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ]
              },
              {
                "description": "A line through two points or more.",
                "type": "object",
                "properties": {
                  "type": {
                    "const": "LineString",
                    "type": "string"
                  },
                  "coordinates": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ]
              },
              {
                "description": "An area: its outer ring, then its holes, each of four positions or\nmore, its last the same as its first.",
                "type": "object",
                "properties": {
                  "type": {
                    "const": "Polygon",
                    "type": "string"
                  },
                  "coordinates": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    }
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ]
              }
            ]
          },
          "properties": {
            "description": "What is said of it: its `name`, for one.",
            "default": {},
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "geometry"
        ]
      },
      "synchronous": false
    },
    "create": {
      "description": "Its name has 1 to 200 characters; its tags 1 to 64 each.",
      "title": "Makes a project.",
      "forms": [
        {
          "href": "/api/v1/projects/create",
          "op": [
            "invokeaction"
          ]
        },
        {
