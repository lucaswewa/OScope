---
source: crates/oscope-api/tests/workspace.rs
expression: td
---
{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "saref": "https://saref.etsi.org/core/"
    }
  ],
  "title": "Workspace",
  "properties": {},
  "actions": {
    "annotate": {
      "description": "On a project's acquisition or result, in layer `layer`, made if need\nbe: a GeoJSON Feature in µm, which replaces the one with its `id`, or\nwith none is new. The feature as kept, with its ID.",
      "title": "Keeps an annotation.",
      "forms": [
        {
          "href": "/api/v1/workspace/annotate",
          "op": [
            "invokeaction"
          ]
        },
        {
          "href": "/api/v1/action_invocations/{id}",
          "op": [
            "queryaction",
            "cancelaction"
          ]
        }
      ],
      "uriVariables": {
        "id": {
          "title": "Invocation ID",
          "format": "uuid",
          "type": "string"
        }
      },
      "input": {
        "title": "annotate_input",
        "type": "object",
        "properties": {
          "project": {
            "description": "A project: a folder of data on disk (P28).",
            "format": "uuid",
            "type": "string"
          },
          "kind": {
            "description": "The kinds of record in a project.",
            "oneOf": [
              {
                "description": "Acquisitions.",
                "const": "acquisition",
                "type": "string"
              },
              {
                "description": "Results.",
                "const": "result",
                "type": "string"
              },
              {
                "description": "Reports.",
                "const": "report",
                "type": "string"
              }
            ]
          },
          "record": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "feature": {
            "description": "A shape, with its ID and its properties, which `name` names.",
            "type": "object",
            "properties": {
              "id": {
                "description": "Its ID, unique in its record: given when it is first kept.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "geometry": {
                "description": "Its shape.",
                "oneOf": [
                  {
                    "description": "A point: `[x, y]`, or `[x, y, z]` in a volume.",
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "Point",
                        "type": "string"
                      },
                      "coordinates": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "required": [
                      "type",
                      "coordinates"
                    ]
                  },
                  {
                    "description": "A line through two points or more.",
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "LineString",
                        "type": "string"
                      },
                      "coordinates": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    "required": [
                      "type",
                      "coordinates"
                    ]
                  },
                  {
                    "description": "An area: its outer ring, then its holes, each of four positions or\nmore, its last the same as its first.",
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "Polygon",
                        "type": "string"
                      },
                      "coordinates": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    },
                    "required": [
                      "type",
                      "coordinates"
                    ]
                  }
                ]
              },
              "properties": {
                "description": "What is said of it: its `name`, for one.",
                "default": {},
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "geometry"
            ]
          }
        },
        "required": [
          "project",
          "kind",
          "record",
          "layer",
          "feature"
        ],
        "additionalProperties": false
      },
      "output": {
        "description": "A shape, with its ID and its properties, which `name` names.",
        "title": "annotate_output",
        "type": "object",
        "properties": {
          "id": {
            "description": "Its ID, unique in its record: given when it is first kept.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "geometry": {
            "description": "Its shape.",
            "oneOf": [
              {
                "description": "A point: `[x, y]`, or `[x, y, z]` in a volume.",
                "type": "object",
                "properties": {
                  "type": {
                    "const": "Point",
                    "type": "string"
                  },
                  "coordinates": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ]
              },
              {
                "description": "A line through two points or more.",
                "type": "object",
                "properties": {
                  "type": {
                    "const": "LineString",
                    "type": "string"
                  },
                  "coordinates": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ]
              },
              {
                "description": "An area: its outer ring, then its holes, each of four positions or\nmore, its last the same as its first.",
                "type": "object",
                "properties": {
                  "type": {
                    "const": "Polygon",
                    "type": "string"
                  },
                  "coordinates": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    }
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ]
              }
            ]
          },
          "properties": {
            "description": "What is said of it: its `name`, for one.",
            "default": {},
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "geometry"
        ]
      },
      "synchronous": false
    },
    "delete_result": {
      "description": "Refused while another result was made from it.",
      "title": "Deletes a result, with its files.",
      "forms": [
        {
          "href": "/api/v1/workspace/delete_result",
          "op": [
            "invokeaction"
          ]
        },
        {
          "href": "/api/v1/action_invocations/{id}",
          "op": [
            "queryaction",
            "cancelaction"
          ]
        }
      ],
      "uriVariables": {
        "id": {
          "title": "Invocation ID",
          "format": "uuid",
          "type": "string"
        }
      },
      "input": {
        "title": "delete_result_input",
        "type": "object",
        "properties": {
          "project": {
            "description": "A project: a folder of data on disk (P28).",
            "format": "uuid",
            "type": "string"
          },
          "result": {
            "description": "A result: an image, a table or a report that a job made.",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "project",
          "result"
        ],
        "additionalProperties": false
      },
      "output": {
        "title": "delete_result_output",
        "type": "null"
      },
      "synchronous": false
    },
    "remove_annotation": {
      "description": "Feature `feature` of layer `layer` of a project's acquisition or\nresult, or with no `feature`, the whole layer.",
      "title": "Removes an annotation, or a layer.",
      "forms": [
        {
          "href": "/api/v1/workspace/remove_annotation",
          "op": [
            "invokeaction"
          ]
        },
        {
          "href": "/api/v1/action_invocations/{id}",
          "op": [
            "queryaction",
            "cancelaction"
          ]
        }
      ],
      "uriVariables": {
        "id": {
          "title": "Invocation ID",
          "format": "uuid",
          "type": "string"
        }
      },
      "input": {
        "title": "remove_annotation_input",
        "type": "object",
        "properties": {
          "project": {
            "description": "A project: a folder of data on disk (P28).",
            "format": "uuid",
            "type": "string"
          },
          "kind": {
            "description": "The kinds of record in a project.",
            "oneOf": [
              {
                "description": "Acquisitions.",
                "const": "acquisition",
                "type": "string"
              },
              {
                "description": "Results.",
                "const": "result",
                "type": "string"
              },
              {
                "description": "Reports.",
                "const": "report",
                "type": "string"
              }
            ]
          },
          "record": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "feature": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "project",
          "kind",
          "record",
          "layer"
        ],
        "additionalProperties": false
      },
      "output": {
        "title": "remove_annotation_output",
        "type": "null"
      },
      "synchronous": false
    },
    "rerun": {
      "description": "Result `result` of a project, made in the Workspace, its analysis\nrun again, with its nodes' parameters changed as `changes` says: by\nthe node's ID in the recipe, each parameter's new value, or `null`\nfor its default.",
      "title": "Makes a result again: a job.",
      "forms": [
        {
          "href": "/api/v1/workspace/rerun",
          "op": [
            "invokeaction"
          ]
        },
        {
          "href": "/api/v1/action_invocations/{id}",
          "op": [
            "queryaction",
            "cancelaction"
          ]
        }
      ],
      "uriVariables": {
        "id": {
          "title": "Invocation ID",
          "format": "uuid",
          "type": "string"
        }
      },
      "input": {
        "title": "rerun_input",
        "type": "object",
        "properties": {
          "project": {
            "description": "A project: a folder of data on disk (P28).",
            "format": "uuid",
            "type": "string"
          },
          "result": {
            "description": "A result: an image, a table or a report that a job made.",
            "format": "uuid",
            "type": "string"
          },
          "changes": {
            "default": {},
            "type": "object",
            "additionalProperties": {
              "additionalProperties": true,
              "type": "object"
            }
          }
        },
        "required": [
          "project",
          "result"
        ],
        "additionalProperties": false
      },
      "output": {
        "description": "Where to follow a job an action has started: what such an action\nanswers with at once (the `JobRef` pattern, ADR-0016).",
        "title": "rerun_output",
        "type": "object",
        "properties": {
          "id": {
            "description": "The job.",
            "format": "uuid",
            "type": "string"
          },
          "href": {
            "description": "Where it is, as it is now.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "href"
        ]
      },
      "synchronous": false
    },
    "run": {
      "description": "A recipe that takes an image, `image`, run on a project's\nacquisition or result, or a region of it in µm, its outputs kept as\na result of the project.",
      "title": "Runs an analysis: a job.",
      "forms": [
        {
          "href": "/api/v1/workspace/run",
          "op": [
            "invokeaction"
          ]
        },
        {
          "href": "/api/v1/action_invocations/{id}",
          "op": [
            "queryaction",
            "cancelaction"
          ]
        }
      ],
      "uriVariables": {
        "id": {
          "title": "Invocation ID",
          "format": "uuid",
          "type": "string"
        }
      },
      "input": {
        "title": "run_input",
        "type": "object",
        "properties": {
          "project": {
            "description": "A project: a folder of data on disk (P28).",
            "format": "uuid",
            "type": "string"
          },
          "analysis": {
            "description": "An analysis: a recipe, and the image it runs on.",
            "type": "object",
            "properties": {
              "recipe": {
                "description": "The recipe (ADR-0017). It takes `image`: grey or RGB in linear\nlight from 0 to 1, a raw image's 2 × 2 cells in colour.",
                "type": "object",
                "properties": {
                  "format": {
                    "description": "Its format: 1, for now.",
                    "type": "integer",
                    "minimum": 0
                  },
                  "name": {
                    "description": "A name for people.",
                    "default": "",
                    "type": "string"
                  },
                  "inputs": {
                    "description": "What it takes, each named and typed: `input.<name>` in its edges.",
                    "default": [],
                    "type": "array",
                    "items": {
                      "description": "A node's input or output, or a recipe's: a name and a type.",
                      "type": "object",
                      "properties": {
                        "name": {
                          "description": "Its name: letters, digits and `_`.",
                          "type": "string"
                        },
                        "type": {
                          "description": "Its values' type.",
                          "oneOf": [
                            {
                              "description": "An image of 32-bit floats, in memory or on the GPU.",
                              "const": "image",
                              "type": "string"
                            },
                            {
                              "description": "Images of one shape: a z-stack, a time series or a volume.",
                              "const": "stack",
                              "type": "string"
                            },
                            {
                              "description": "A binary mask, a byte a pixel.",
                              "const": "mask",
                              "type": "string"
                            },
                            {
                              "description": "A table: named columns, and rows.",
                              "const": "table",
                              "type": "string"
                            },
                            {
                              "description": "Shapes, as GeoJSON.",
                              "const": "geometry",
                              "type": "string"
                            },
                            {
                              "description": "A number, or any JSON.",
                              "const": "json",
                              "type": "string"
                            },
                            {
                              "description": "A fragment of a report.",
                              "const": "report",
                              "type": "string"
                            }
                          ]
                        },
                        "optional": {
                          "description": "For a node's input: whether it may be left without an edge.",
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "name",
                        "type"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "nodes": {
                    "description": "Its nodes.",
                    "type": "array",
                    "items": {
                      "description": "A node in a recipe.",
                      "type": "object",
                      "properties": {
                        "id": {
                          "description": "Its ID in the recipe: letters, digits and `_`, and not `input`.",
                          "type": "string"
                        },
                        "node": {
                          "description": "Which node it is: its descriptor's ID.",
                          "type": "string"
                        },
                        "version": {
                          "description": "The node's version the recipe was made for: the registry's must be\nthe same, when given.",
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "params": {
                          "description": "Its parameters, which the node's schema checks.",
                          "default": {}
                        }
                      },
                      "required": [
                        "id",
                        "node"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "edges": {
                    "description": "Its edges.",
                    "default": [],
                    "type": "array",
                    "items": {
                      "description": "An edge: from a node's output, or a recipe input, to a node's input, each\n`node.port`.",
                      "type": "object",
                      "properties": {
                        "from": {
                          "description": "The output: `blur.image`, or `input.image` for a recipe input.",
                          "type": "string"
                        },
                        "to": {
                          "description": "The input: `threshold.image`.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "from",
                        "to"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "outputs": {
                    "description": "What it gives.",
                    "type": "array",
                    "items": {
                      "description": "One of a recipe's outputs.",
                      "type": "object",
                      "properties": {
                        "name": {
                          "description": "Its name.",
                          "type": "string"
                        },
                        "from": {
                          "description": "The node's output, or recipe input, it gives: `node.port`.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "from"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "layout": {
                    "description": "Where an editor drew each node, by its ID: `[x, y]`, in its own\nunits. The engine ignores it (W7.2).",
                    "type": "object",
                    "additionalProperties": {
                      "items": {
                        "type": "number"
                      },
                      "maxItems": 2,
                      "minItems": 2,
                      "type": "array"
                    }
                  }
                },
                "required": [
                  "format",
                  "nodes",
                  "outputs"
                ],
                "additionalProperties": false
              },
              "input": {
                "description": "The image: an acquisition's or a result's.",
                "oneOf": [
                  {
                    "description": "An acquisition.",
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "acquisition",
                        "type": "string"
                      },
                      "id": {
                        "description": "An acquisition: one run that records frames into a project (P29).",
                        "format": "uuid",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "id"
                    ]
                  },
                  {
                    "description": "Another result.",
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "result",
                        "type": "string"
                      },
                      "id": {
                        "description": "A result: an image, a table or a report that a job made.",
                        "format": "uuid",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "id"
                    ]
                  }
                ]
              },
              "roi": {
                "description": "A region of it: all of it unless given.",
                "oneOf": [
                  {
                    "description": "A region of an image, in µm from its top-left corner, x across and y\ndown, as annotations are (P44): on an image of unknown pixel size, a µm\nis a pixel.",
                    "type": "object",
                    "properties": {
                      "x": {
                        "description": "Its left edge.",
                        "type": "number"
                      },
                      "y": {
                        "description": "Its top edge.",
                        "type": "number"
                      },
                      "width": {
                        "description": "Its width.",
                        "type": "number"
                      },
                      "height": {
                        "description": "Its height.",
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tile": {
                "description": "Tiles this many pixels square, to run tile by tile: whole unless\ngiven.",
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "description": "The result's name: the recipe's unless given.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "recipe",
              "input"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "project",
          "analysis"
        ],
        "additionalProperties": false
      },
      "output": {
        "description": "Where to follow a job an action has started: what such an action\nanswers with at once (the `JobRef` pattern, ADR-0016).",
        "title": "run_output",
        "type": "object",
        "properties": {
          "id": {
            "description": "The job.",
            "format": "uuid",
            "type": "string"
          },
          "href": {
            "description": "Where it is, as it is now.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "href"
        ]
      },
      "synchronous": false
    }
  },
  "description": "The Workspace: analyses on a project's images, their results and their\nprovenance, and annotations.",
  "forms": [
    {
      "href": "/api/v1/workspace/actions",
      "op": [
        "queryallactions"
      ]
    }
  ],
  "base": "http://testserver/",
  "securityDefinitions": {
    "no_security": {
      "description": "No security",
      "scheme": "nosec"
    }
  },
  "security": "no_security",
  "@type": "saref:Function"
}
