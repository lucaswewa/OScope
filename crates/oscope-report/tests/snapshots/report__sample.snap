<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>A sample report</title>
<style>
  :root { color-scheme: light; font: 15px system-ui, sans-serif; }
  body { margin: 0 auto; padding: 24px 16px; max-width: 900px; background: #fff; color: #111; }
  header { text-align: center; }
  h1 { margin: 0; font-size: 1.6em; }
  .subtitle { font-size: 1.15em; }
  .date { color: #888; font-size: 0.9em; }
  table { border-collapse: collapse; margin: 8px 0; font-variant-numeric: tabular-nums; }
  th, td { padding: 2px 10px; text-align: left; border-bottom: 1px solid #8884; }
  .fields th { border: none; }
  .fields td { border: none; }
  figure { margin: 12px 0; }
  figcaption { font-style: italic; font-size: 0.9em; }
  img { max-width: 100%; }
</style>
</head>
<body>
<header>
  <h1>A sample report</h1>
  <div class="subtitle">Every kind of block</div>
  <div class="date">2026-01-01</div>
</header>

<table class="fields">
  <tr><th>Project</th><td>a project</td></tr>
  <tr><th>Sample</th><td>a slide</td></tr>
</table>


<section>
<h2>Results</h2>

<p>Some text.</p>


<figure><img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAAAAABX3VL4AAAADklEQVR4nGNpYGBiYAAAAqQAhz/Ex4IAAAAASUVORK5CYII=" alt="An image" style="width: 20.0%"><figcaption>An image</figcaption></figure>


<figure><table>
  <tr><th>a</th><th>b</th></tr>
  <tr><td>1</td><td>2</td></tr>
</table><figcaption>A table</figcaption></figure>


<figure><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 260" width="480" height="260" font-family="Roboto, sans-serif" font-size="11"><path d="M56.00 12.00V216.00H468.00" fill="none" stroke="#555"/><text x="50.00" y="220.00" text-anchor="end">0</text><text x="50.00" y="118.00" text-anchor="end">1</text><text x="50.00" y="16.00" text-anchor="end">2</text><text x="159.00" y="232.00" text-anchor="middle">x</text><text x="365.00" y="232.00" text-anchor="middle">y</text><rect x="76.60" y="114.00" width="164.80" height="102.00" fill="#4c78a8"/><rect x="282.60" y="12.00" width="164.80" height="204.00" fill="#4c78a8"/><text x="262.00" y="254.00" text-anchor="middle">label</text><text transform="translate(14 114.00) rotate(-90)" text-anchor="middle">value</text></svg><figcaption>A chart</figcaption></figure>


</section>


<section>
<h2>Provenance</h2>
<table class="fields">
  <tr><th>Software</th><td>OScope</td></tr>
</table>
</section>

</body>
</html>
