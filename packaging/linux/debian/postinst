#!/bin/sh
# OScope's .deb (P54, ADR-0033), once unpacked: its account, its folders, and
# its service, enabled and started, or started again on an upgrade.
set -e

if [ "$1" = configure ]; then
    if ! getent passwd oscope >/dev/null; then
        adduser --system --group --home /var/lib/oscope --no-create-home \
            --shell /usr/sbin/nologin oscope
    fi
    install -d -o oscope -g oscope -m 750 /var/lib/oscope
    # The settings Thing (P52) writes the configuration, keeping a backup
    # beside it: the folder and the file are the account's to change.
    chown root:oscope /etc/oscope /etc/oscope/oscope.toml
    chmod 775 /etc/oscope
    chmod 664 /etc/oscope/oscope.toml
fi

# Without systemd running, as in a container, there is no service to start.
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable oscope.service >/dev/null
    systemctl restart oscope.service
fi
exit 0
