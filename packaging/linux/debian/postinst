#!/bin/sh
# OScope's .deb (P54, ADR-0033), once unpacked: its account, its folders, and
# its service, enabled and started, or started again on an upgrade.
set -e

if [ "$1" = configure ]; then
    if ! getent passwd oscoped >/dev/null; then
        adduser --system --group --home /var/lib/oscope --no-create-home \
            --shell /usr/sbin/nologin oscoped
    fi
    # 0.1.0's account was oscope: what it wrote becomes oscoped's.
    if getent passwd oscope >/dev/null; then
        for folder in /var/lib/oscope /etc/oscope; do
            if [ -d "$folder" ]; then
                find "$folder" -user oscope -exec chown oscoped:oscoped {} +
            fi
        done
    fi
    install -d -o oscoped -g oscoped -m 750 /var/lib/oscope
    # The settings Thing (P52) writes the configuration, keeping a backup
    # beside it: the folder and the file are the account's to change, and its
    # group's, whose other members are its operators.
    chown root:oscoped /etc/oscope /etc/oscope/oscope.toml
    chmod 775 /etc/oscope
    chmod 664 /etc/oscope/oscope.toml
fi

# Without systemd running, as in a container, there is no service to start.
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable oscope.service >/dev/null
    systemctl restart oscope.service
fi
exit 0
