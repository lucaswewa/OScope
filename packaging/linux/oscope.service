# OScope's server as a systemd service (ADR-0015). The .deb installs it (P54,
# ADR-0033: packaging/README.md).
#
# To install it by hand, as root:
#   useradd --system --home-dir /var/lib/oscope --shell /usr/sbin/nologin oscoped
#   install -m 755 oscope-server /usr/bin/
#   install -D -m 644 oscope.toml /etc/oscope/oscope.toml
#   install -m 644 oscope.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now oscope
#
# test-user-unit.sh tries this unit as a user's, without root.

[Unit]
Description=OScope microscope server
Documentation=https://github.com/lucaswewa/OScope
After=network.target

[Service]
Type=exec
User=oscoped
Group=oscoped
# The stage's controller, grblHAL, comes on a serial port in M3: Ubuntu gives
# serial ports to the group dialout.
SupplementaryGroups=dialout
ExecStart=/usr/bin/oscope-server --config /etc/oscope/oscope.toml
# SIGTERM stops it as Ctrl-C does: invocations cancelled, requests finished,
# the Things stopped and their settings saved. The wait covers the grace
# period.
KillSignal=SIGTERM
TimeoutStopSec=30
# Exit code 75 asks for a restart (the system Thing's restart); a failure
# restarts it too.
Restart=on-failure
RestartForceExitStatus=75
RestartSec=2
# Its own folder, /var/lib/oscope, writable, and its configuration's, which
# the settings Thing changes (P52); the rest of the system not. Its group, its
# operators, may read its folder, and no one else.
StateDirectory=oscope
StateDirectoryMode=0750
ReadWritePaths=/etc/oscope
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
