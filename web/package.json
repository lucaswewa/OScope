{
  "name": "oscope-web",
  "version": "0.2.0",
  "description": "OScope's app: one Vue 3 codebase for the browser and the desktop.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port 8280 --strictPort",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "licences": "node scripts/check-licences.mjs",
    "advisories": "node scripts/check-advisories.mjs",
    "api:types": "node scripts/api-types.mjs",
    "api:check": "node scripts/api-types.mjs --check",
    "test:unit": "node scripts/vitest.mjs run",
    "test:e2e": "playwright test",
    "test:workflows": "playwright test -c playwright.workflows.config.ts",
    "test:visual": "node scripts/visual.mjs",
    "test:a11y": "playwright test --project chromium --grep \"@a11y|axe can find\"",
    "test:perf": "playwright test -c playwright.perf.config.ts --reporter=list"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@kitware/vtk.js": "38.0.5",
    "@material-symbols/svg-300": "^0.48.2",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "openapi-fetch": "^0.17.0",
    "openseadragon": "6.1.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.17",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
